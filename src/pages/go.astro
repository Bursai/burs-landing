---
// src/pages/go.astro
// Link-in-bio landing page — the single link used in TikTok / Instagram bios
// during launch. Deliberately does NOT extend Base.astro: no nav, no footer,
// no distractions. Same brand tokens/fonts/reset as every other page, just a
// bare <html> so there is truly nothing here but the ask.
//
// ?src=<value> (e.g. /go?src=tt or /go?src=ig) is threaded onto the App
// Store link as Apple's campaign token (ct) + media type (mt=8) so installs
// can be attributed back to the bio that drove them.
//
// ⚠️ 2026-08-03: THIS PAGE NOW RENDERS FOR *EVERYONE* — paid and organic.
// Until this date, `vercel.json` held a bare 302 for /go that matched
// `?utm_campaign=<any token-safe value>` at the edge and sent paid ad
// clicks straight to the App Store before Astro (or the Meta pixel, or the
// Vercel analytics beacon) ever ran. That made every paid click
// unmeasurable — 906 SEK of Meta spend from 2026-07-26 onward left no
// trace. The redirect is gone; this page now renders immediately for both
// audiences, fires the beacons, then hands off to the App Store after a
// short delay (see the inline script below) so the pixel gets a chance to
// fire before the tab navigates away.
//
// This is a fully static build (no SSR adapter — see astro.config.mjs), so
// Astro.url.searchParams is NOT available at build time; the real query
// string only exists in the visitor's browser. The campaign token is
// therefore still resolved client-side, exactly as it always was — see the
// inline script. `buildAppStoreUrl` (src/lib/links.ts) is the single
// source of truth for the URL shape + validation and is used both for the
// server-rendered default (ct=direct, used as the pre-JS href and the
// <noscript> fallback) and mirrored by the client script for the
// campaign-aware rewrite.
//
// LAUNCHING A NEW CAMPAIGN? Nothing to do — `buildAppStoreUrl` accepts any
// `utm_campaign`/`src`/`utm_source` of [a-zA-Z0-9_-]{1,32} and forwards it
// as the ct token. (Until 2026-08-02 the old edge rule hardcoded
// `meta-m1-se`; M3 shipped with a different token and every click silently
// fell back to this interstitial.) Anything outside that charset — or
// missing entirely — falls back to ct=direct.
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/typography.css";
import "../styles/utilities.css";
import Schema from "../components/Schema.astro";
import MetaPixel from "../components/MetaPixel.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import WebAnalytics from "../components/WebAnalytics.astro";
import { organization } from "../lib/schema";
import { buildAppStoreUrl } from "../lib/links";
const TITLE = "BURS — Start your free trial";
const DESCRIPTION = "Outfits from clothes you already own. Start your 3-day free trial.";
const CANONICAL = "https://www.burs.me/go";
// Static build → no per-request query string here, so this is the pre-JS /
// no-JS default (ct=direct). The client script below resolves the real
// campaign from window.location.search and rewrites both the link and the
// redirect target before the 700ms handoff fires.
const target = buildAppStoreUrl(null);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={CANONICAL} />
  <meta name="theme-color" content="#F5F0E8" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Smart App Banner — same tag as the shared layout; repeated here since
       /go intentionally doesn't extend Base.astro. -->
  <meta name="apple-itunes-app" content="app-id=6772630210" />

  <!-- Meta Pixel + domain verification; ViewContent marks /go as the
       paid-traffic landing for the click-optimized campaigns. -->
  <MetaPixel viewContent />

  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content="https://www.burs.me/og-image.png" />
  <meta property="og:image:alt" content={TITLE} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={DESCRIPTION} />

  <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />

  <Schema json={organization()} />
</head>
<body class="go-body">
  <!-- No-JS fallback: send the visitor on with the default (ct=direct)
       target immediately. JS-enabled visitors get the campaign-aware
       rewrite + delayed handoff below instead, so the pixel gets a chance
       to fire first. -->
  <noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
  <div class="grain" aria-hidden="true"></div>
  <main class="go">
    <div class="go__inner wrap">
      <img src="/logo-256.png" width="256" height="256" alt="" class="go__mark" />
      <h1 class="go__word">BURS</h1>
      <p class="go__tagline">Outfits from clothes you already own</p>

      <a id="go-cta" class="cta go__cta" href={target}>
        Start your 3-day free trial <span class="cta__arrow" aria-hidden="true">→</span>
      </a>

      <a class="go__home" href="/">burs.me</a>
    </div>
  </main>

  <ConsentBanner />

  <!-- Vercel Web Analytics. THIS is the tag that finally makes a paid /go
       landing countable. MetaPixel above only fires once the visitor has
       accepted the consent banner, and a paid click is handed off to the
       App Store ~700ms after load — long before anyone answers a banner —
       so the pixel misses effectively every first-time paid visitor.
       Vercel's beacon is cookieless and first-party, so it needs no consent
       gate and fires on every landing. It matters most HERE, because this
       is the page paid clicks land on: /go?…&fbclid=… is also the one URL
       carrying a per-click identifier, which is why the component strips
       every non-campaign query param before reporting (see
       WebAnalytics.astro).

       Repeated here on purpose: /go deliberately does NOT extend
       Base.astro (see the header comment), so the WebAnalytics component in
       that layout never reaches this page — and this is the one page where
       the measurement matters most. The shared component is what keeps the
       two placements from drifting.

       Placed at the end of the body, NOT in head as vercel.com/docs shows.
       It renders a vercel-analytics custom element, and the HTML parser
       closes head at the first unknown element — Astro appends its own
       stylesheet/style/hoisted script tags AFTER page head content, so a
       head placement relocates every stylesheet into the body (verified: 2
       of 2 stylesheets moved). Loading is unaffected by this position:
       Astro hoists the component's module script into head either way.

       No literal tags in this prose on purpose: Astro emits comments
       verbatim, and tests/html.smoke.ts greps the built HTML to prove the
       beacon actually shipped. A commented-out copy of the markup would
       satisfy that grep on its own and make the check meaningless. -->
  <WebAnalytics />

  <script is:inline define:vars={{ target }}>
    // Apple campaign-token attribution: /go?src=tt → ct=tt&mt=8 on the
    // install link, so TikTok vs Instagram bio traffic is distinguishable
    // in App Store Connect / App Analytics. Resolved client-side because
    // this is a static build (see frontmatter) — the real query string
    // only exists in the browser, never at build time.
    //
    // 2026-07-26: `src` alone silently dropped every PAID click. The Meta
    // campaign sends `?utm_source=meta&utm_campaign=meta-m1-se&...` and never
    // a `src`, so this returned early and the install link went to Apple with
    // NO `ct` token — 377 paid clicks (789 SEK) landed unattributed and were
    // indistinguishable from organic in App Store Connect. Fall back to the
    // utm_* pair that ad platforms actually send. `utm_campaign` is preferred
    // because it already carries the campaign-scoped value (`meta-m1-se`) that
    // /download hardcodes, so both entry points report the SAME token.
    //
    // Validation mirrors resolveCampaign + buildAppStoreUrl
    // (src/lib/links.ts): the whole campaign value must match
    // [a-zA-Z0-9_-]{1,32} or that param is skipped entirely — never a
    // stripped/partial token — so a hostile value can't leak anything into
    // the App Store URL (see the injection tests in links.test.ts).
    //
    // The params are read first-VALID, not first-present. Meta's standard
    // `{{campaign.name}}` macro expands to the human campaign name, so a
    // campaign named "BURS M4 SE" arrives as `utm_campaign=BURS M4 SE`;
    // first-present would let that one malformed value bucket the click as
    // ct=direct — indistinguishable from organic in App Store Connect —
    // instead of falling through to `utm_source=meta`.
    (function () {
      var params = new URLSearchParams(window.location.search);
      var CAMPAIGN_RE = /^[a-zA-Z0-9_-]{1,32}$/;
      var CAMPAIGN_KEYS = ['src', 'utm_campaign', 'utm_source'];
      var ct = 'direct';
      for (var i = 0; i < CAMPAIGN_KEYS.length; i++) {
        var candidate = params.get(CAMPAIGN_KEYS[i]);
        if (candidate && CAMPAIGN_RE.test(candidate)) {
          ct = candidate;
          break;
        }
      }
      var dest = target.split('?')[0] + '?l=en-GB&ct=' + encodeURIComponent(ct) + '&mt=8';

      var link = document.getElementById('go-cta');
      if (link) link.href = dest;

      // 2026-08-03: this is the actual fix. Paid clicks used to 302 at the
      // Vercel edge before this page — or the Meta pixel — ever ran, so
      // measurement was zero. Now the page renders first: an
      // already-consented return visitor's pixel (MetaPixel.astro, which
      // fires ViewContent on its own once consent is granted — no need to
      // call fbq again here) gets 700ms to fire before the tab leaves. A
      // first-time visitor who hasn't yet answered the consent banner still
      // won't be measured on this visit — that is the GDPR trade-off, not a
      // bug — but the visible CTA link means a blocked or skipped redirect
      // still converts.
      var handoff = setTimeout(function () {
        handoff = null;
        // MetaPixel.astro fires its InitiateAppStore custom event from a
        // delegated CLICK listener on apps.apple.com links. This handoff
        // replaces the click, so without firing it here the signal would
        // silently drop to zero on the one page it matters most. Guarded:
        // fbq only exists once consent was granted, so this is a no-op for
        // everyone else and stays inside the consent gate.
        if (typeof window.fbq === 'function') {
          window.fbq('trackCustom', 'InitiateAppStore', {
            page: window.location.pathname,
            src: ct,
          });
        }
        window.location.replace(dest);
      }, 700);

      // If the visitor acts first — taps the CTA, or the burs.me link —
      // their navigation wins. Cancelling stops the timer from overriding
      // where they chose to go, and stops InitiateAppStore firing twice
      // (MetaPixel's own click listener already covers a real tap).
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a');
        if (a && handoff !== null) {
          clearTimeout(handoff);
          handoff = null;
        }
      });
    })();
  </script>
</body>
</html>

<style>
  .go-body{ min-height: 100dvh }
  .go{
    min-height: 100dvh;
    display: flex; align-items: center; justify-content: center;
    background: var(--cream);
    padding-block: 48px;
  }
  .go__inner{
    max-width: 420px;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }
  .go__mark{ width: 56px; height: 56px; margin-bottom: 20px }
  .go__word{
    font-size: clamp(48px, 14vw, 72px);
    margin: 0;
    color: var(--charcoal);
  }
  .go__tagline{
    font-family: var(--serif); font-style: italic;
    color: var(--charcoal-2);
    font-size: clamp(17px, 4.4vw, 20px);
    line-height: 1.45;
    margin-top: 14px;
    max-width: 26ch;
  }
  .go__cta{
    margin-top: 40px;
    width: 100%; max-width: 340px;
    justify-content: center;
    font-size: 15px;
    padding: 18px 30px;
  }
  .go__home{
    margin-top: 24px;
    font-family: var(--mono); font-size: 11px; letter-spacing: .24em; text-transform: uppercase;
    color: var(--charcoal); opacity: .55;
    transition: opacity .3s var(--eo), color .3s var(--eo);
  }
  .go__home:hover{ opacity: 1; color: var(--gold-deep) }
</style>
