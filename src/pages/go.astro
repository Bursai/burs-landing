---
// src/pages/go.astro
// Link-in-bio landing page — the single link used in TikTok / Instagram bios
// during launch. Deliberately does NOT extend Base.astro: no nav, no footer,
// no distractions. Same brand tokens/fonts/reset as every other page, just a
// bare <html> so there is truly nothing here but the ask.
//
// ?src=<value> (e.g. /go?src=tt or /go?src=ig) is threaded onto the App
// Store link as Apple's campaign token (ct) + media type (mt=8) so installs
// can be attributed back to the bio that drove them.
//
// ⚠️ 2026-08-03: THIS PAGE NOW RENDERS FOR *EVERYONE* — paid and organic.
// Until this date, `vercel.json` held a bare 302 for /go that matched
// `?utm_campaign=<any token-safe value>` at the edge and sent paid ad
// clicks straight to the App Store before Astro (or the Meta pixel, or the
// Vercel analytics beacon) ever ran. That made every paid click
// unmeasurable — 906 SEK of Meta spend from 2026-07-26 onward left no
// trace. The redirect is gone; this page now renders immediately for both
// audiences, fires the beacons, then hands off to the App Store after a
// short delay (see the inline script below) so the pixel gets a chance to
// fire before the tab navigates away.
//
// This is a fully static build (no SSR adapter — see astro.config.mjs), so
// Astro.url.searchParams is NOT available at build time; the real query
// string only exists in the visitor's browser. The campaign token is
// therefore still resolved client-side, exactly as it always was — see the
// inline script. `buildAppStoreUrl` (src/lib/links.ts) is the single
// source of truth for the URL shape + validation and is used both for the
// server-rendered default (ct=direct, used as the pre-JS href and the
// <noscript> fallback) and mirrored by the client script for the
// campaign-aware rewrite.
//
// LAUNCHING A NEW CAMPAIGN? Nothing to do — `resolveCampaign` /
// `CampaignToken.astro` accept any `src`/`utm_campaign`/`utm_source` of
// [a-zA-Z0-9_-]{1,32} and `buildAppStoreUrl` forwards it as the ct token. (Until 2026-08-02 the old edge rule hardcoded
// `meta-m1-se`; M3 shipped with a different token and every click silently
// fell back to this interstitial.) Anything outside that charset — or
// missing entirely — falls back to ct=direct.
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/typography.css";
import "../styles/utilities.css";
import Schema from "../components/Schema.astro";
import CampaignToken from "../components/CampaignToken.astro";
import MetaPixel from "../components/MetaPixel.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import WebAnalytics from "../components/WebAnalytics.astro";
import { organization } from "../lib/schema";
import { buildAppStoreUrl } from "../lib/links";
const TITLE = "BURS — Start your free trial";
const DESCRIPTION = "Outfits from clothes you already own. Start your 3-day free trial.";
const CANONICAL = "https://www.burs.me/go";
// Static build → no per-request query string here, so this is the pre-JS /
// no-JS default (ct=direct). CampaignToken.astro (rendered in <head>) resolves
// the real campaign in the browser and publishes it as window.__bursCampaign;
// the script at the end of <body> reads that one token and rewrites both the
// link and the redirect target before the 700ms handoff fires.
const target = buildAppStoreUrl(null);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={CANONICAL} />
  <meta name="theme-color" content="#F5F0E8" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Smart App Banner — same tag as the shared layout; repeated here since
       /go intentionally doesn't extend Base.astro. -->
  <meta name="apple-itunes-app" content="app-id=6772630210" />

  <!-- Resolves the campaign token once (src → utm_campaign → utm_source) into
       window.__bursCampaign. MUST stay ahead of MetaPixel and of the handoff
       script at the end of <body>: both read what this defines, and this page
       is the one where a mislabelled token turns a paid install into an
       apparently organic one. -->
  <CampaignToken />

  <!-- Meta Pixel + domain verification; ViewContent marks /go as the
       paid-traffic landing for the click-optimized campaigns. -->
  <MetaPixel viewContent />

  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content="https://www.burs.me/og-image.png" />
  <meta property="og:image:alt" content={TITLE} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={DESCRIPTION} />

  <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />

  <Schema json={organization()} />
</head>
<body class="go-body">
  <!-- No-JS fallback: send the visitor on with the default (ct=direct)
       target immediately. JS-enabled visitors get the campaign-aware
       rewrite + delayed handoff below instead, so the pixel gets a chance
       to fire first. -->
  <noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
  <div class="grain" aria-hidden="true"></div>
  <main class="go">
    <div class="go__inner wrap">
      <img src="/logo-256.png" width="256" height="256" alt="" class="go__mark" />
      <h1 class="go__word">BURS</h1>
      <p class="go__tagline">Outfits from clothes you already own</p>

      <a id="go-cta" class="cta go__cta" href={target}>
        Start your 3-day free trial <span class="cta__arrow" aria-hidden="true">→</span>
      </a>

      <a class="go__home" href="/">burs.me</a>
    </div>
  </main>

  <ConsentBanner />

  <!-- Vercel Web Analytics. THIS is the tag that finally makes a paid /go
       landing countable. MetaPixel above only fires once the visitor has
       accepted the consent banner, and a paid click is handed off to the
       App Store ~700ms after load — long before anyone answers a banner —
       so the pixel misses effectively every first-time paid visitor.
       Vercel's beacon is cookieless and first-party, so it needs no consent
       gate and fires on every landing. It matters most HERE, because this
       is the page paid clicks land on: /go?…&fbclid=… is also the one URL
       carrying a per-click identifier, which is why the component strips
       every non-campaign query param before reporting (see
       WebAnalytics.astro).

       Repeated here on purpose: /go deliberately does NOT extend
       Base.astro (see the header comment), so the WebAnalytics component in
       that layout never reaches this page — and this is the one page where
       the measurement matters most. The shared component is what keeps the
       two placements from drifting.

       Placed at the end of the body, NOT in head as vercel.com/docs shows.
       It renders a vercel-analytics custom element, and the HTML parser
       closes head at the first unknown element — Astro appends its own
       stylesheet/style/hoisted script tags AFTER page head content, so a
       head placement relocates every stylesheet into the body (verified: 2
       of 2 stylesheets moved). Loading is unaffected by this position:
       Astro hoists the component's module script into head either way.

       No literal tags in this prose on purpose: Astro emits comments
       verbatim, and tests/html.smoke.ts greps the built HTML to prove the
       beacon actually shipped. A commented-out copy of the markup would
       satisfy that grep on its own and make the check meaningless. -->
  <WebAnalytics />

  <script is:inline define:vars={{ target }}>
    // Apple campaign-token attribution: /go?src=tt → ct=tt&mt=8 on the
    // install link, so TikTok vs Instagram bio traffic is distinguishable
    // in App Store Connect / App Analytics. Resolved client-side because
    // this is a static build (see frontmatter) — the real query string
    // only exists in the browser, never at build time.
    //
    // 2026-07-26: `src` alone silently dropped every PAID click. The Meta
    // campaign sends `?utm_source=meta&utm_campaign=meta-m1-se&...` and never
    // a `src`, so this returned early and the install link went to Apple with
    // NO `ct` token — 377 paid clicks (789 SEK) landed unattributed and were
    // indistinguishable from organic in App Store Connect. Fall back to the
    // utm_* pair that ad platforms actually send. `utm_campaign` is preferred
    // because it already carries the campaign-scoped value (`meta-m1-se`) that
    // /download hardcodes, so both entry points report the SAME token.
    //
    // The resolution itself lives in ONE place — CampaignToken.astro, in
    // <head>, which publishes window.__bursCampaign. This page used to carry
    // its own copy of the key list, the regex and the fallback, and
    // MetaPixel's delegated click listener carried a third, `src`-only
    // variant; a consented visitor who tapped the CTA before the handoff
    // reported ct=direct while the handoff reported the real token. Read the
    // shared token here, never re-derive it.
    //
    // Validation (unchanged, enforced by CampaignToken.astro from
    // CAMPAIGN_RE_SOURCE in src/lib/links.ts): the whole campaign value must
    // match [a-zA-Z0-9_-]{1,32} or that param is skipped entirely — never a
    // stripped/partial token — so a hostile value can't leak anything into
    // the App Store URL (see the injection tests in links.test.ts). Params are
    // read first-VALID, not first-present, so Meta's `{{campaign.name}}` macro
    // expanding to "BURS M4 SE" falls through to `utm_source=meta` instead of
    // bucketing a paid click as ct=direct.
    (function () {
      // 'direct' matches buildAppStoreUrl's fallback, i.e. the `target` the
      // build already rendered into the href — so if the head script somehow
      // never ran, this rebuilds the SAME url rather than a broken one.
      var ct = window.__bursCampaign || 'direct';
      var dest = target.split('?')[0] + '?l=en-GB&ct=' + encodeURIComponent(ct) + '&mt=8';

      var link = document.getElementById('go-cta');
      if (link) link.href = dest;

      // 2026-08-03: this is the actual fix. Paid clicks used to 302 at the
      // Vercel edge before this page — or the Meta pixel — ever ran, so
      // measurement was zero. Now the page renders first: an
      // already-consented return visitor's pixel (MetaPixel.astro, which
      // fires ViewContent on its own once consent is granted — no need to
      // call fbq again here) gets time to fire before the tab leaves. A
      // first-time visitor who hasn't yet answered the consent banner still
      // won't be measured on this visit — that is the GDPR trade-off, not a
      // bug — but the visible CTA link means a blocked or skipped redirect
      // still converts.
      //
      // HANDOFF_MS is the EARLIEST we leave; MAX_WAIT_MS is the absolute
      // ceiling on this page for every waiting path below (timed handoff and
      // early tap alike). Two independent measurement signals have to get out
      // before the document dies — the Vercel beacon and, when consent was
      // granted, the Meta pixel — and they share this one budget. Nothing
      // extends it: a paid click is a person waiting on a blank-ish page.
      var HANDOFF_MS = 700;
      var MAX_WAIT_MS = 2000;
      var startedAt = Date.now();
      var handoff = null;

      // ANDROID: no automatic handoff. `dest` is an apps.apple.com listing
      // and BURS has no Google Play listing to send them to instead, so
      // auto-navigating an Android visitor dumps them in a store where they
      // cannot install anything, with the page they came for already gone.
      // They keep the rendered page and the visible CTA. (The site's FAQ and
      // terms do claim Android availability — that copy is wrong today and
      // is a separate, marketing-owned problem, not something this redirect
      // can paper over.)
      var isAndroid = /Android/i.test(navigator.userAgent || '');

      // ── SIGNAL 1 of 2: the Vercel analytics beacon ─────────────────────
      // Did the analytics beacon actually get a request out yet? On a cold
      // mobile connection Astro's hoisted module and the injected
      // /_vercel/insights/script.js can still be in flight at 700ms, and
      // location.replace() cancels them — leaving exactly the paid visits
      // this page exists to count unmeasured. So 700ms is the EARLIEST we
      // leave, not a fixed deadline: past it we poll until the beacon shows
      // up in resource timing, capped hard at MAX_WAIT_MS so a blocked or
      // disabled beacon can never strand the visitor here.
      //
      // "Issued" is the right bar, not "completed". Vercel's client sends the
      // pageview as `fetch(<view>, { method: "POST", keepalive: true })`
      // (verbatim from va.vercel-scripts.com/v1/script.js), and a keepalive
      // fetch is specified to outlive the document — the browser finishes it
      // after unload. So the moment a /_vercel/insights/view request exists in
      // resource timing, leaving costs nothing. The ONLY window that loses a
      // visit is before that request is issued at all, i.e. while the
      // insights script itself is still downloading, because a pending script
      // load IS cancelled by navigation and then no beacon is ever created.
      function beaconFlushed() {
        try {
          var entries = performance.getEntriesByType('resource');
          for (var j = 0; j < entries.length; j++) {
            if (entries[j].name.indexOf('/_vercel/insights/view') !== -1) return true;
          }
          return false;
        } catch (e) {
          return true; // can't measure it → don't hold the visitor up
        }
      }

      // ── SIGNAL 2 of 2: the consent-gated Meta pixel ────────────────────
      // The beacon's "issued is enough" reasoning does NOT transfer, and that
      // asymmetry is the whole point of this block. MetaPixel.astro installs
      // Meta's standard snippet, whose stub is
      //     fbq = function () { fbq.callMethod
      //       ? fbq.callMethod.apply(fbq, arguments)
      //       : fbq.queue.push(arguments) }
      // and immediately queues init + PageView + ViewContent. Until
      // connect.facebook.net/en_US/fbevents.js has executed, every one of
      // those calls is sitting in a plain in-memory array: no request has been
      // issued, there is nothing for `keepalive` to keep alive, and unloading
      // cancels the still-downloading script so the queue is never drained.
      // A stub-queued event is a lost event, 100% of the time — so for a
      // consented visitor, beaconFlushed() alone declared this page "measured"
      // while PageView, ViewContent and the InitiateAppStore fired by leave()
      // below all died with the document.
      //
      // Once fbevents.js runs it assigns the real implementation onto the
      // global (`e.callMethod = Fe` in the vendor bundle — that assignment is
      // the contract the stub above branches on) and replays the queue
      // synchronously. Only from that moment do the events become requests,
      // and those requests ARE unload-safe: fbevents ships them through
      // signalsFBEventsSendFetch (`fetch(url, {keepalive: true})`),
      // signalsFBEventsSendBeacon (navigator.sendBeacon) or
      // signalsFBEventsSendGET (an Image GET — the same fire-and-forget every
      // click-time pixel on the web has always relied on). So
      // `typeof fbq.callMethod === 'function'` is the exact instant the Meta
      // events stop being cancellable: the same "issued, therefore safe to
      // leave" bar beaconFlushed() uses, just reached later.
      //
      // Do NOT substitute `fbq.loaded` or "fbq exists": the STUB sets
      // `n.loaded = !0` on itself and IS a function, so both are true from the
      // first millisecond and would gate exactly nothing.

      // Wait only when the pixel is genuinely coming. A visitor who declined,
      // who hasn't answered the banner yet, or whose storage is blocked never
      // loads fbevents.js at all — holding them would be pure added latency on
      // a paid click, waiting for a request that will never exist. The consent
      // read below is MetaPixel.astro's gate restated (same key, same
      // "granted" literal, same live event, same storage-blocked fallback); if
      // that gate ever changes, this moves with it or /go starts stalling
      // people who were never going to be measured anyway.
      var CONSENT_KEY = 'burs-consent-v1';
      var consented = false;
      try {
        consented = localStorage.getItem(CONSENT_KEY) === 'granted';
      } catch (e) {
        consented = false; // storage blocked → the pixel stays off → nothing to wait for
      }

      // EXPECTED, not merely consented. MetaPixel runs in <head>, so a stored
      // consent means its stub is already installed by the time this
      // end-of-body script runs. If it isn't there, the pixel is not coming at
      // all (its inline script was blocked or threw) and waiting for it would
      // be pure dead time on a paid click.
      var pixelExpected = consented && typeof window.fbq === 'function';

      // Consent granted live (banner "Allow") starts the pixel loading right
      // then, with the stub appearing a moment later — so arm the wait from
      // the event rather than from fbq. Matters most on Android, which gets no
      // timed handoff at all, so the click grace below is the only wait that
      // visitor ever hits.
      window.addEventListener('burs:consent', function (e) {
        if (e && e.detail === 'granted') pixelExpected = true;
      });

      function pixelFlushed() {
        // Not coming (no consent, no stub) or never arriving (the script
        // errored — see MetaPixel's t.onerror, which sets this flag at element
        // creation because a blocked request fails long before anything down
        // here could attach a listener) → nothing to wait for.
        if (!pixelExpected || window.__bursPixelDead) return true;
        var f = window.fbq;
        return typeof f === 'function' && typeof f.callMethod === 'function';
      }

      // Both signals, one predicate. Every path that can end this document —
      // the timed handoff, an early tap, the grace loop — asks this and only
      // this, so the two can't drift apart the way the campaign token did.
      // Still bounded by MAX_WAIT_MS at every call site: a slow pixel delays
      // the handoff, it can never prevent it.
      function measurementFlushed() {
        return beaconFlushed() && pixelFlushed();
      }

      function leave() {
        handoff = null;
        // MetaPixel.astro fires its InitiateAppStore custom event from a
        // delegated CLICK listener on apps.apple.com links. This handoff
        // replaces the click, so without firing it here the signal would
        // silently drop to zero on the one page it matters most. Guarded:
        // fbq only exists once consent was granted, so this is a no-op for
        // everyone else and stays inside the consent gate.
        //
        // Note the guard alone was never enough to make the event REAL: the
        // stub is also `typeof 'function'`, so this used to queue
        // InitiateAppStore into the doomed array one statement before
        // location.replace() destroyed it. pixelFlushed() above is what turns
        // this call into an actual keepalive/sendBeacon/Image request.
        if (typeof window.fbq === 'function') {
          window.fbq('trackCustom', 'InitiateAppStore', {
            page: window.location.pathname,
            src: ct,
          });
        }
        window.location.replace(dest);
      }

      function tick() {
        if (Date.now() - startedAt < MAX_WAIT_MS && !measurementFlushed()) {
          handoff = setTimeout(tick, 100);
          return;
        }
        leave();
      }

      if (!isAndroid) handoff = setTimeout(tick, HANDOFF_MS);

      // If the visitor acts first — taps the CTA, or the burs.me link —
      // their navigation wins. Cancelling stops the timer from overriding
      // where they chose to go, and stops InitiateAppStore firing twice
      // (MetaPixel's own click listener already covers a real tap).
      //
      // Cancelling alone used to be the whole handler, which quietly opted a
      // fast tap out of the readiness wait the timed handoff gets: tap inside
      // the first ~700ms — or any tap at all on Android, where there is no
      // timer — and the page unloaded with the insights script still
      // downloading, so no beacon was ever issued. That is the same
      // unmeasurable paid click this page exists to eliminate, just reached
      // by a different route.
      //
      // A tap is also the ONE path that can lose the pixel's InitiateAppStore
      // even when this page fires nothing itself: MetaPixel's own click
      // listener queues that event into the stub, so a tap taken while
      // fbevents.js is still downloading drops it exactly like the timed
      // handoff used to. Waiting here for pixelFlushed() drains that queued
      // event too — the grace period covers both signals, not just the beacon.
      //
      // THE TRADE-OFF, deliberately: a real tap is a paid click and must not
      // feel held up, so the grace period below is (a) skipped entirely once
      // both signals are out — the overwhelmingly common case, since an
      // already-consented visitor has fbevents.js in HTTP cache and the beacon
      // needs no consent (see beaconFlushed / pixelFlushed) — (b)
      // capped at 300ms, under the ~400ms at which a delay starts reading as
      // unresponsive, (c) additionally capped by the page-wide MAX_WAIT_MS
      // budget, so a late tap waits proportionally less and a tap after the
      // budget waits not at all, and (d) resolved the instant both signals
      // land, so it usually ends well before the cap. Nothing here can
      // strand a visitor: every path ends in a navigation.
      var CLICK_GRACE_MS = 300;

      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a');
        if (!a) return;

        if (handoff !== null) {
          clearTimeout(handoff);
          handoff = null;
        }

        // Signals already out (or unmeasurable) → never touch the navigation.
        if (measurementFlushed()) return;

        // Only ever take over a plain, same-tab left click. A modified click
        // (new tab/window/download) leaves this document alive, so there is
        // nothing to protect and hijacking it would break the gesture.
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (a.target && a.target !== '_self') return;
        var href = a.href;
        if (!href) return;

        var deadline = Math.min(Date.now() + CLICK_GRACE_MS, startedAt + MAX_WAIT_MS);
        if (deadline <= Date.now()) return; // out of budget → go now

        e.preventDefault();
        (function waitThenGo() {
          if (Date.now() < deadline && !measurementFlushed()) {
            setTimeout(waitThenGo, 50);
            return;
          }
          window.location.href = href;
        })();
      });
    })();
  </script>
</body>
</html>

<style>
  .go-body{ min-height: 100dvh }
  .go{
    min-height: 100dvh;
    display: flex; align-items: center; justify-content: center;
    background: var(--cream);
    padding-block: 48px;
  }
  .go__inner{
    max-width: 420px;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }
  .go__mark{ width: 56px; height: 56px; margin-bottom: 20px }
  .go__word{
    font-size: clamp(48px, 14vw, 72px);
    margin: 0;
    color: var(--charcoal);
  }
  .go__tagline{
    font-family: var(--serif); font-style: italic;
    color: var(--charcoal-2);
    font-size: clamp(17px, 4.4vw, 20px);
    line-height: 1.45;
    margin-top: 14px;
    max-width: 26ch;
  }
  .go__cta{
    margin-top: 40px;
    width: 100%; max-width: 340px;
    justify-content: center;
    font-size: 15px;
    padding: 18px 30px;
  }
  .go__home{
    margin-top: 24px;
    font-family: var(--mono); font-size: 11px; letter-spacing: .24em; text-transform: uppercase;
    color: var(--charcoal); opacity: .55;
    transition: opacity .3s var(--eo), color .3s var(--eo);
  }
  .go__home:hover{ opacity: 1; color: var(--gold-deep) }
</style>
