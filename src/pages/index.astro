---
import Base from "../layouts/Base.astro";
import HeroFilm from "../components/HeroFilm.astro";
import ScrollStory from "../components/ScrollStory.astro";
import WeekReel from "../components/WeekReel.astro";
import MarkSeal from "../components/MarkSeal.astro";
import Schema from "../components/Schema.astro";
import { softwareApplication, product } from "../lib/schema";
---
<Base
  title="BURS — Your wardrobe, intelligently styled."
  description="An AI wardrobe stylist. Scans the clothes you already own, reads the weather and your calendar, and recommends one outfit for every day."
  path="/"
  bodyClass="dark-nav"
>
  <Schema slot="head" json={[softwareApplication(), product()]} />

  <!-- The page's story is told scene by scene as you scroll; this compact
       synopsis gives search engines and assistive tech the whole arc up
       front, with a real h1. -->
  <div class="sr-only">
    <h1>BURS — your wardrobe, intelligently styled</h1>
    <p>
      BURS is an AI wardrobe stylist — the first real personal stylist. Scan
      your closet once (under ten minutes; twenty to thirty for a big
      wardrobe) and that's the last work you'll do: from then on you only
      tell it the occasion or the mood, say "style me", or just talk to it in
      plain language. It reads what you own, how you feel, the weather and
      the day, and answers with one outfit for every day of your week — and
      it will never tell you to buy anything. See
      <a href="/method">how it works</a> or <a href="/pricing">pricing</a>.
    </p>
  </div>

  <!-- ATTENTION — the opening film, one full-viewport beat -->
  <HeroFilm />

  <!-- THE STORY — what the app does, scrubbed by scroll: scan once (under
       ten minutes; twenty to thirty for a big wardrobe), then only ever say
       the occasion / the mood / "style me", or just talk to it. The first
       real stylist — it never sells you anything. -->
  <ScrollStory />

  <!-- THE WEEK — a scroll-driven week; the days glide by and each one's outfit
       draws itself in, closing on the App Store CTA. -->
  <WeekReel />

  <!-- THE SIGNATURE — the mark stitches itself from loose thread, the page's
       closing seal before the footer. -->
  <MarkSeal />
</Base>
