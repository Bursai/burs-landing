---
// src/components/ScrollStory.astro
// The film, remade natively — no video. Four pinned, scroll-scrubbed scenes
// (ink stage, line-art garments drawing themselves in cream + gold) that
// explain exactly what BURS does:
//
//   01 THE SCAN     — a phone drawn in the same lines as the garments appears,
//                     then scans five pieces one by one: each is drawn under a
//                     sweeping gold beam, its details are read off, and it is
//                     added to your closet. Under ten minutes (twenty to
//                     thirty for a big wardrobe), once, ever.
//   02 THEN NOTHING — the only input you'll ever give: the occasion, the
//                     mood, or simply "style me".
//   03 OR JUST TALK — a conversation; the answer draws itself on a hanger.
//   04 THE REAL STYLIST — clothes + feel + weather + occasion converge into
//                     one outfit. "Buy this / buy that" get struck through:
//                     it never sells you anything.
//
// Everything is real DOM text (crawlable, screen-reader-visible); the SVGs
// are decorative. Reduced-motion / no-JS collapse the runways and show every
// scene fully drawn as a static page.
import { HANGER, GARMENTS } from "../lib/garments";

interface ScanItem { garment: string; name: string; specs: [string, string][] }
// Five pieces are read off, one at a time, and added to the closet.
const SCAN_ITEMS: ScanItem[] = [
  { garment: "blazer", name: "Tailored blazer", specs: [["FABRIC", "Wool"],   ["COLOUR", "Navy"],  ["CUT", "Sharp"]] },
  { garment: "dress",  name: "Silk slip dress", specs: [["FABRIC", "Silk"],   ["COLOUR", "Black"], ["FOR", "Evening"]] },
  { garment: "coat",   name: "Wool overcoat",   specs: [["FABRIC", "Wool"],   ["COLOUR", "Camel"], ["WEIGHT", "Warm"]] },
  { garment: "shirt",  name: "Cotton shirt",    specs: [["FABRIC", "Cotton"], ["COLOUR", "Ivory"], ["FEEL", "Crisp"]] },
  { garment: "knit",   name: "Merino knit",     specs: [["FABRIC", "Merino"], ["COLOUR", "Oat"],   ["FEEL", "Soft"]] },
];

const chips = [
  { k: "THE OCCASION", v: "“Dinner at eight.”" },
  { k: "THE MOOD",     v: "“Quietly sharp.”" },
  { k: "OR SIMPLY",    v: "“Style me.”" },
];

const sources = ["YOUR CLOTHES", "HOW YOU FEEL", "THE WEATHER", "THE OCCASION"];
---

<!-- ============ 01 · THE SCAN ============ -->
<!-- A phone, drawn in the garments' own line weight, assembles from its lines,
     then scans five pieces: each draws in under a sweeping gold beam, its
     details are read off, and it drops into the closet as the counter climbs. -->
<section class="scan" data-scene="scan" aria-labelledby="scan-title">
  <div class="scan__stage">
    <div class="scan__head">
      <p class="eyebrow story-eyebrow">01 — THE SCAN</p>
      <h2 id="scan-title" class="story-h">First, it <em>reads</em> your closet.</h2>
      <!-- Server-rendered at 148 so the static fallbacks agree with a filled
           closet; JS rewrites it from 000 on the first frame of the scrub. -->
      <p class="story-counter"><span data-scan-count>148</span> PIECES CATALOGUED</p>
    </div>

    <div class="scan__scan">
      <!-- the phone, drawn line by line -->
      <div class="scan__phone" data-scan-phone aria-hidden="true">
        <svg class="phone__svg" viewBox="0 0 104 208" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <g class="phone__lines">
            <path class="pl" pathLength="1" d="M20 4 H84 Q100 4 100 20 V188 Q100 204 84 204 H20 Q4 204 4 188 V20 Q4 4 20 4 Z" />
            <path class="pl" pathLength="1" d="M46 13 H58" />
            <path class="pl" pathLength="1" d="M42 196 H62" />
          </g>
          <circle class="phone__lens" cx="66" cy="13" r="1.8" />
        </svg>

        <div class="view" data-scan-view>
          <span class="view__bracket view__bracket--tl"></span>
          <span class="view__bracket view__bracket--tr"></span>
          <span class="view__bracket view__bracket--bl"></span>
          <span class="view__bracket view__bracket--br"></span>
          {SCAN_ITEMS.map((it, i) => (
            <figure class="view__garment" data-vg={i}>
              <svg viewBox="0 0 120 175" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <g class="garment">
                  {GARMENTS[it.garment].line.map(p => <path class="gl" d={p} pathLength="1" />)}
                  {GARMENTS[it.garment].gold.map(p => <path class="gl gl--gold" d={p} pathLength="1" />)}
                </g>
              </svg>
            </figure>
          ))}
          <span class="view__beam" data-scan-beam></span>
        </div>
      </div>

      <!-- what the scan reads off each piece -->
      <div class="detail-wrap" aria-hidden="true">
        {SCAN_ITEMS.map((it, i) => (
          <div class="detail" data-detail={i}>
            <span class="detail__rule"></span>
            <p class="detail__name">{it.name}</p>
            <ul class="detail__specs">
              {it.specs.map(([k, v]) => (
                <li class="detail__row"><span class="detail__k">{k}</span><span class="detail__v">{v}</span></li>
              ))}
            </ul>
            <p class="detail__added">✓ Added to your closet</p>
          </div>
        ))}
      </div>
    </div>

    <div class="scan__foot">
      <!-- the five, collecting as they're added -->
      <div class="added" aria-hidden="true">
        <p class="added__label">Your closet, filling</p>
        <div class="added__row">
          {SCAN_ITEMS.map((it, i) => (
            <span class="added__slot" data-added={i}>
              <svg viewBox="0 0 120 175" fill="none">
                {GARMENTS[it.garment].line.map(p => <path class="ml" d={p} />)}
                {GARMENTS[it.garment].gold.map(p => <path class="ml ml--gold" d={p} />)}
              </svg>
            </span>
          ))}
        </div>
      </div>

      <p class="scan__lede lede">
        Point your camera along the rail. Under ten minutes — twenty to thirty
        for a big wardrobe — <em>then never again</em>.
      </p>
    </div>
  </div>
</section>

<!-- ============ 02 · THEN, NOTHING ============ -->
<section class="ask" data-scene="ask" aria-labelledby="ask-title">
  <div class="ask__stage">
    <div class="wrap ask__inner">
      <p class="eyebrow story-eyebrow">02 — THEN, NOTHING</p>
      <h2 id="ask-title" class="story-h">That was the work. <em>All of it.</em></h2>
      <p class="lede ask__lede">From here on, you give it one sentence — or none.</p>
      <div class="ask__chips">
        {chips.map((c, i) => (
          <div class="chip" data-ask-chip={i}>
            <span class="chip__k">{c.k}</span>
            <span class="chip__v">{c.v}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ 03 · OR JUST TALK ============ -->
<section class="talk" data-scene="talk" aria-labelledby="talk-title">
  <div class="talk__stage">
    <div class="wrap talk__inner">
      <p class="eyebrow story-eyebrow">03 — OR JUST TALK</p>
      <h2 id="talk-title" class="story-h">No menus. A <em>conversation</em>.</h2>

      <div class="talk__thread">
        <div class="bubble bubble--you" data-bubble="0">
          <span class="bubble__txt">Friday. I want to look like I tried — without trying.</span>
        </div>
        <div class="bubble bubble--burs" data-bubble="1">
          <span class="bubble__txt">Your overcoat over the roll-neck. The straight trouser. Done.</span>
        </div>
        <figure class="talk__fit" data-talk-fit aria-hidden="true">
          <svg viewBox="0 0 120 175" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <g class="hanger">
                {HANGER.map(p => <path d={p} />)}
              </g>
            <g class="garment">
              {GARMENTS.coat.line.map(p => <path class="gl" d={p} pathLength="1" />)}
              {GARMENTS.coat.gold.map(p => <path class="gl gl--gold" d={p} pathLength="1" />)}
            </g>
          </svg>
          <figcaption class="talk__fit-cap">FRI — THE OFF-SITE</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<!-- ============ 04 · THE REAL STYLIST ============ -->
<section class="real" data-scene="real" aria-labelledby="real-title">
  <div class="real__stage">
    <div class="wrap real__inner">
      <p class="eyebrow story-eyebrow">04 — THE REAL STYLIST</p>
      <h2 id="real-title" class="story-h">The <em>first</em> of its kind.</h2>

      <div class="real__box" aria-hidden="true">
        {sources.map((s, i) => (
          <span class={`real__src real__src--${i}`} data-real-src={i}>{s}</span>
        ))}
        <svg class="real__lines" viewBox="0 0 100 60" preserveAspectRatio="none">
          <path d="M8 9 C 28 18, 40 25, 49 29" data-real-line="0" vector-effect="non-scaling-stroke" />
          <path d="M92 9 C 72 18, 60 25, 51 29" data-real-line="1" vector-effect="non-scaling-stroke" />
          <path d="M8 51 C 28 43, 40 36, 49 31" data-real-line="2" vector-effect="non-scaling-stroke" />
          <path d="M92 51 C 72 43, 60 36, 51 31" data-real-line="3" vector-effect="non-scaling-stroke" />
        </svg>
        <figure class="real__fit" data-real-fit>
          <svg viewBox="0 0 120 175" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <g class="hanger">
                {HANGER.map(p => <path d={p} />)}
              </g>
            <g class="garment">
              {GARMENTS.dress.line.map(p => <path class="gl" d={p} pathLength="1" />)}
              {GARMENTS.dress.gold.map(p => <path class="gl gl--gold" d={p} pathLength="1" />)}
            </g>
          </svg>
        </figure>
      </div>

      <div class="real__vow">
        <p class="real__no">
          <span class="strike" data-strike="0">“Buy this.”</span>
          <span class="strike" data-strike="1">“Buy that.”</span>
          <span class="real__never" data-real-never>— never.</span>
        </p>
        <p class="lede real__lede" data-real-lede>
          It reads what you own, how you feel, the weather and the day —
          and answers with <em>real style</em>. Nothing to shop. Nothing to decide.
        </p>
      </div>
    </div>
  </div>
</section>

<noscript>
  <style>
    /* Without JS the scrub can't run — collapse the runways and lay the
       story out as a plain page with everything fully drawn. */
    .scan, .ask, .talk, .real { height: auto !important; }
    .scan__stage, .ask__stage, .talk__stage, .real__stage {
      position: static !important; height: auto !important; overflow: visible !important;
      padding-block: 72px;
    }
    .scan__stage { justify-content: flex-start !important; gap: 36px !important; }
    .scan__scan { flex-direction: column !important; }
    .pl { stroke-dashoffset: 0 !important; opacity: 1 !important; }
    .phone__lens { opacity: 1 !important; }
    .view__garment { opacity: 0 !important; }
    .view__beam { display: none !important; }
    .detail-wrap { display: none !important; }
    .gl { stroke-dashoffset: 0 !important; opacity: 1 !important; }
    .added__slot { opacity: 1 !important; }
    .added__slot svg { transform: none !important; }
    .added__slot .ml { stroke: var(--cream) !important; }
    .added__slot .ml--gold { stroke: var(--gold) !important; }
    .chip, .bubble { opacity: 1 !important; transform: none !important; }
    .bubble__txt { clip-path: none !important; }
    .talk__fit, .real__fit, .real__src, .real__never, .real__lede { opacity: 1 !important; transform: none !important; }
    .real__lines path { opacity: 1 !important; }
    .strike::after { transform: scaleX(1) !important; }
    .strike { color: rgba(245,240,232,.35) !important; }
  </style>
</noscript>

<style>
  /* ---------- shared story type ---------- */
  .story-eyebrow{ color: var(--gold-bright); opacity: 1 }
  .story-h{
    margin: 6px 0 0; font-family: var(--display); font-weight: 200;
    letter-spacing: -.03em; line-height: 1.02;
    font-size: clamp(30px, 4.4vw, 60px); color: var(--cream); text-wrap: balance;
  }
  .story-h :global(em){ font-style: italic; color: var(--gold); font-weight: 300 }
  .story-counter{
    margin-top: 10px;
    font-family: var(--mono); font-size: 11px; letter-spacing: .3em;
    color: rgba(245,240,232,.5);
  }
  .story-counter span{ color: var(--gold-bright) }

  /* garment strokes (shared).
     The offset is a calc in px (with pathLength=1, 1px == the whole path) —
     Gecko rejects unitless calc() for stroke-dashoffset, which would leave
     every garment fully drawn from the start in Firefox. The opacity ramp
     hides the zero-length dash that Blink paints as a stray round-cap dot
     when --draw is 0. */
  .hanger path{ stroke: rgba(245,240,232,.55); stroke-width: 1.4; fill: none }
  .gl{
    stroke: var(--cream); stroke-width: 1.6; fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: calc((1 - var(--draw, 0)) * 1px);
    opacity: clamp(0, calc(var(--draw, 0) * 20), 1);
  }
  .gl--gold{ stroke: var(--gold); stroke-width: 1.5 }

  /* ============ 01 · THE SCAN ============ */
  .scan{ position: relative; height: 460vh; background: var(--ink) }
  .scan__stage{
    position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    padding: clamp(80px, 10vh, 116px) var(--gutter) clamp(18px, 4vh, 44px);
    color: var(--cream);
  }
  .scan__head{
    flex: 0 0 auto;
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px;
  }
  .scan__scan{
    flex: 1 1 auto; min-height: 0; width: 100%;
    display: flex; align-items: center; justify-content: center;
    gap: clamp(24px, 4vw, 64px);
  }
  .scan__foot{
    flex: 0 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: clamp(14px, 2.6vh, 26px);
  }
  .scan__lede{
    width: min(54ch, 88vw); text-align: center; color: rgba(245,240,232,.6);
  }
  .scan__lede :global(em){ color: var(--gold-bright) }

  /* the phone — drawn in the garments' own line weight, it assembles itself in */
  .scan__phone{
    --pd: 1;
    position: relative; flex: 0 0 auto;
    height: min(46svh, 396px);
    aspect-ratio: 104 / 208;
    filter: drop-shadow(0 44px 80px rgba(0,0,0,.55));
  }
  .phone__svg{ position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible }
  .phone__lines .pl{
    stroke: rgba(245,240,232,.72); stroke-width: 1.3; fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: calc((1 - var(--pd, 0)) * 1px);
    opacity: clamp(0, calc(var(--pd, 0) * 20), 1);
  }
  .phone__lens{ fill: var(--gold); opacity: clamp(0, calc((var(--pd, 0) - .55) * 4), 1) }

  /* the camera view: brackets frame the piece, the beam reads it */
  .view{ position: absolute; left: 7%; right: 7%; top: 10.5%; bottom: 9.5%; overflow: hidden }
  .view__bracket{
    position: absolute; width: 13px; height: 13px; border: 1.4px solid var(--gold); opacity: .55;
    transition: opacity .3s var(--eo), border-color .3s var(--eo), box-shadow .3s var(--eo);
  }
  .view__bracket--tl{ top: 3px; left: 3px; border-right: 0; border-bottom: 0; border-top-left-radius: 3px }
  .view__bracket--tr{ top: 3px; right: 3px; border-left: 0; border-bottom: 0; border-top-right-radius: 3px }
  .view__bracket--bl{ bottom: 3px; left: 3px; border-right: 0; border-top: 0; border-bottom-left-radius: 3px }
  .view__bracket--br{ bottom: 3px; right: 3px; border-left: 0; border-top: 0; border-bottom-right-radius: 3px }
  .view.is-lock .view__bracket{ opacity: 1; border-color: var(--gold-bright); box-shadow: 0 0 8px rgba(224,189,125,.5) }

  .view__garment{
    position: absolute; left: 50%; top: 50%; margin: 0;
    height: 78%; aspect-ratio: 120/175;
    transform: translate(-50%, -50%);
    opacity: 0; will-change: transform, opacity;
  }
  .view__garment svg{ width: 100%; height: 100%; overflow: visible }

  .view__beam{
    position: absolute; left: 6%; right: 6%; top: 0; height: 2px; border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--gold-bright) 20%, var(--gold-bright) 80%, transparent);
    box-shadow: 0 0 12px 2px rgba(224,189,125,.5);
    opacity: 0; transition: opacity .16s linear; pointer-events: none;
  }

  /* the details, read off each piece */
  .detail-wrap{
    position: relative; flex: 0 0 auto;
    width: min(260px, 38vw); height: min(46svh, 396px);
  }
  .detail{
    position: absolute; top: 50%; left: 0; right: 0; transform: translateY(-50%);
    opacity: 0; transition: opacity .4s var(--eo);
  }
  .detail.show{ opacity: 1 }
  .detail__rule{ display: block; width: 30px; height: 1px; background: var(--gold); opacity: .7; margin-bottom: 14px }
  .detail__name{
    margin: 0; font-family: var(--display); font-style: italic; font-weight: 300;
    font-size: clamp(21px, 2vw, 30px); color: var(--cream); line-height: 1.05;
  }
  .detail__specs{ list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px }
  .detail__row{
    display: flex; gap: 12px; align-items: baseline;
    opacity: 0; transform: translateY(6px);
    transition: opacity .45s var(--eo), transform .45s var(--eo);
  }
  .detail.show .detail__row{ opacity: 1; transform: none }
  .detail.show .detail__row:nth-child(1){ transition-delay: .05s }
  .detail.show .detail__row:nth-child(2){ transition-delay: .15s }
  .detail.show .detail__row:nth-child(3){ transition-delay: .25s }
  .detail__k{
    font-family: var(--mono); font-size: 9px; letter-spacing: .22em;
    color: rgba(245,240,232,.45); min-width: 64px;
  }
  .detail__v{
    font-family: var(--serif); font-style: italic; font-size: clamp(15px, 1.4vw, 18px); color: var(--cream);
  }
  .detail__added{
    margin: 20px 0 0; font-family: var(--mono); font-size: 10px; letter-spacing: .2em;
    color: var(--gold-bright);
    opacity: 0; transform: translateY(6px);
    transition: opacity .4s var(--eo), transform .4s var(--eo);
  }
  .detail.added .detail__added{ opacity: 1; transform: none }

  /* the five, collecting as they're added */
  .added{ display: flex; flex-direction: column; align-items: center; gap: clamp(10px, 1.6vh, 16px) }
  .added__label{
    font-family: var(--mono); font-size: 10px; letter-spacing: .24em; text-transform: uppercase;
    color: rgba(245,240,232,.4);
  }
  .added__row{ display: flex; align-items: flex-end; gap: clamp(12px, 1.8vw, 26px) }
  .added__slot{
    width: clamp(36px, 4vw, 50px); aspect-ratio: 3/4; display: grid; place-items: center;
    opacity: .26; transition: opacity .5s var(--eo);
  }
  .added__slot svg{ width: 100%; height: 100%; overflow: visible; transform: scale(.7); transition: transform .5s var(--eo) }
  .added__slot .ml{ stroke: rgba(245,240,232,.5); stroke-width: 2.4; fill: none; stroke-linecap: round; stroke-linejoin: round }
  .added__slot .ml--gold{ stroke: rgba(201,168,108,.5) }
  .added__slot.is-in{ opacity: 1 }
  .added__slot.is-in svg{ transform: none }
  .added__slot.is-in .ml{ stroke: var(--cream) }
  .added__slot.is-in .ml--gold{ stroke: var(--gold) }

  /* ============ 02 · THEN, NOTHING ============ */
  .ask{ position: relative; height: 260vh; background: var(--ink) }
  .ask__stage{
    position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden;
    display: flex; align-items: center;
    color: var(--cream);
  }
  .ask__inner{ display: flex; flex-direction: column; align-items: center; text-align: center; width: 100% }
  .ask__lede{ margin-top: 16px; color: rgba(245,240,232,.6) }
  .ask__chips{
    margin-top: clamp(34px, 6vh, 64px);
    display: flex; gap: clamp(12px, 2vw, 24px); flex-wrap: wrap; justify-content: center;
  }
  .chip{
    display: flex; flex-direction: column; gap: 8px; align-items: flex-start;
    min-width: 210px;
    padding: 18px 24px;
    background: rgba(245,240,232,.03);
    border: 1px solid rgba(245,240,232,.14);
    border-radius: 3px;
    opacity: 0; transform: translateY(18px);
    transition: opacity .6s var(--eo), transform .6s var(--eo), border-color .6s var(--eo);
  }
  .chip.in{ opacity: 1; transform: none; border-color: rgba(201,168,108,.45) }
  .chip__k{
    font-family: var(--mono); font-size: 9px; letter-spacing: .28em;
    color: var(--gold-bright);
  }
  .chip__v{
    font-family: var(--serif); font-style: italic; font-size: clamp(17px, 1.6vw, 21px);
    color: var(--cream);
  }

  /* ============ 03 · OR JUST TALK ============ */
  .talk{ position: relative; height: 340vh; background: var(--ink) }
  .talk__stage{
    position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden;
    display: flex; align-items: center;
    color: var(--cream);
  }
  .talk__inner{ display: flex; flex-direction: column; align-items: center; text-align: center; width: 100% }
  .talk__thread{
    margin-top: clamp(30px, 5vh, 56px);
    width: min(620px, 92vw);
    display: flex; flex-direction: column; gap: 16px;
  }
  .bubble{
    max-width: 46ch;
    padding: 14px 20px;
    border-radius: 16px;
    font-family: var(--serif); font-style: italic;
    font-size: clamp(15px, 1.5vw, 18px); line-height: 1.45;
    text-align: left;
    opacity: 0; transform: translateY(14px);
    transition: opacity .5s var(--eo), transform .5s var(--eo);
  }
  .bubble.in{ opacity: 1; transform: none }
  .bubble__txt{
    display: inline-block;
    clip-path: inset(-6px calc((1 - var(--t, 0)) * 100%) -6px -6px);
  }
  .bubble--you{
    align-self: flex-end;
    background: var(--cream); color: var(--charcoal);
    border-bottom-right-radius: 4px;
  }
  .bubble--burs{
    align-self: flex-start;
    background: rgba(245,240,232,.05);
    border: 1px solid rgba(201,168,108,.4);
    color: var(--cream);
    border-bottom-left-radius: 4px;
  }
  .talk__fit{
    margin: 10px auto 0;
    width: clamp(120px, 13vw, 160px);
    opacity: 0; transform: translateY(12px);
    transition: opacity .6s var(--eo), transform .6s var(--eo);
  }
  .talk__fit.in{ opacity: 1; transform: none }
  .talk__fit svg{ width: 100%; overflow: visible }
  .talk__fit-cap{
    margin-top: 8px;
    font-family: var(--mono); font-size: 8px; letter-spacing: .26em;
    color: rgba(245,240,232,.5); text-align: center;
  }

  /* ============ 04 · THE REAL STYLIST ============ */
  .real{ position: relative; height: 380vh; background: var(--ink) }
  .real__stage{
    position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden;
    display: flex; align-items: center;
    color: var(--cream);
  }
  .real__inner{ display: flex; flex-direction: column; align-items: center; text-align: center; width: 100% }

  .real__box{
    position: relative;
    margin-top: clamp(20px, 4vh, 44px);
    width: min(760px, 92vw);
    height: clamp(240px, 38svh, 350px);
  }
  .real__src{
    position: absolute;
    font-family: var(--mono); font-size: clamp(8px, .8vw, 10px); letter-spacing: .26em;
    color: rgba(245,240,232,.55);
    opacity: 0; transform: translateY(8px);
    transition: opacity .55s var(--eo), transform .55s var(--eo), color .55s var(--eo);
  }
  .real__src.in{ opacity: 1; transform: none; color: var(--gold-bright) }
  .real__src--0{ top: 6%; left: 0 }
  .real__src--1{ top: 6%; right: 0 }
  .real__src--2{ bottom: 6%; left: 0 }
  .real__src--3{ bottom: 6%; right: 0 }

  .real__lines{ position: absolute; inset: 0; width: 100%; height: 100% }
  /* Under vector-effect the dash pattern is screen-space (a stitched look,
     echoing the seam motif), so the draw-in is done with opacity instead of
     dashoffset — each thread fades in as its source lights up. */
  .real__lines path{
    stroke: rgba(201,168,108,.6); stroke-width: 1; fill: none;
    stroke-dasharray: 6 5;
    opacity: var(--draw, 0);
  }

  .real__fit{
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: clamp(110px, 12vw, 150px);
    margin: 0;
  }
  .real__fit svg{ width: 100%; overflow: visible }

  .real__vow{ margin-top: clamp(18px, 3.5vh, 36px) }
  .real__no{
    font-family: var(--display); font-weight: 300; font-style: italic;
    font-size: clamp(20px, 2.4vw, 30px);
    color: rgba(245,240,232,.75);
    display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; align-items: baseline;
  }
  .strike{ position: relative; transition: color .5s var(--eo) }
  .strike::after{
    content: ""; position: absolute; left: -3%; right: -3%; top: 54%;
    height: 1.5px; background: var(--gold);
    transform: scaleX(var(--sx, 0)); transform-origin: left center;
  }
  .strike.is-dead{ color: rgba(245,240,232,.3) }
  .real__never{
    color: var(--gold-bright); font-style: italic;
    opacity: 0; transform: translateY(6px);
    transition: opacity .5s var(--eo), transform .5s var(--eo);
  }
  .real__never.in{ opacity: 1; transform: none }
  .real__lede{
    margin: 18px auto 0; width: min(56ch, 88vw);
    color: rgba(245,240,232,.6);
    opacity: 0; transform: translateY(10px);
    transition: opacity .6s var(--eo), transform .6s var(--eo);
  }
  .real__lede.in{ opacity: 1; transform: none }
  .real__lede :global(em){ color: var(--gold-bright) }

  /* ---------- mobile ---------- */
  @media (max-width: 800px){
    .scan{ height: 420vh }
    .ask{ height: 220vh }
    .talk{ height: 280vh }
    .real{ height: 320vh }

    /* Stack head → phone+details → closet+lede from the top with real gaps.
       (The desktop `space-between` distributed NEGATIVE space on short
       phones, overlapping the heading, phone and closet.) */
    .scan__stage{
      justify-content: flex-start;
      gap: clamp(10px, 2vh, 20px);
      /* clear the 84px fixed nav */
      padding: clamp(76px, 10vh, 90px) var(--gutter) clamp(14px, 2.5vh, 28px);
    }
    .scan__head{ gap: 4px }
    .story-h{ font-size: clamp(25px, 7vw, 40px) }
    .story-counter{ margin-top: 6px }

    .scan__scan{ flex: 0 0 auto; flex-direction: column; gap: clamp(8px, 1.6vh, 16px); width: 100% }
    .scan__phone{ height: clamp(150px, 31svh, 250px) }

    /* one compact caption under the phone: name · specs (inline) · added —
       only the active piece is in flow, so nothing overlaps */
    .detail-wrap{ width: min(360px, 90vw); height: auto; min-height: clamp(70px, 13vh, 88px); text-align: center }
    .detail{ position: static; transform: none; display: none }
    .detail.show{ display: block }
    .detail__rule{ margin: 0 auto 8px }
    .detail__name{ font-size: clamp(18px, 5vw, 24px) }
    .detail__specs{ flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 3px 9px; margin-top: 8px }
    .detail__k{ display: none }
    .detail__row{ justify-content: center }
    .detail__row + .detail__row::before{ content: "·"; color: var(--gold); opacity: .7; margin-right: 9px }
    .detail__v{ font-size: clamp(14px, 3.8vw, 17px) }
    .detail__added{ margin-top: 10px; font-size: 9.5px }

    .scan__foot{ gap: clamp(8px, 1.6vh, 14px) }
    .added__label{ font-size: 9px }
    .added__slot{ width: clamp(30px, 7.5vw, 44px) }
    .scan__lede{ font-size: clamp(12.5px, 3.4vw, 15px); width: min(42ch, 90vw) }

    .chip{ min-width: 0; width: min(320px, 84vw) }
    .real__box{ height: 230px }
  }

  /* Short viewports — small phones once the browser's address bar has eaten
     into the height. Shrink the phone and drop the supporting lede so the
     core scan (phone + details + closet) always fits without cropping. */
  @media (max-width: 800px) and (max-height: 640px){
    .scan__stage{ padding-top: clamp(70px, 9vh, 80px); gap: clamp(8px, 1.4vh, 15px) }
    .scan__phone{ height: clamp(132px, 27svh, 200px) }
  }
  @media (max-width: 800px) and (max-height: 560px){
    .scan__stage{ padding-top: clamp(66px, 8vh, 74px); gap: clamp(7px, 1.2vh, 12px) }
    .scan__phone{ height: clamp(118px, 24svh, 168px) }
  }
  /* only the very shortest phones drop the supporting lede */
  @media (max-width: 800px) and (max-height: 520px){
    .scan__lede{ display: none }
  }

  /* ---------- reduced motion: a static, fully-scanned page ---------- */
  @media (prefers-reduced-motion: reduce){
    .scan, .ask, .talk, .real{ height: auto }
    .scan__stage, .ask__stage, .talk__stage, .real__stage{
      position: static; height: auto; overflow: visible;
      padding-block: clamp(56px, 9vh, 110px);
    }
    .scan__stage{ justify-content: flex-start; gap: clamp(30px, 5vh, 52px) }
    .scan__scan{ flex-direction: column }
    .scan__phone{ --pd: 1 }
    .pl{ stroke-dashoffset: 0; opacity: 1 }
    .phone__lens{ opacity: 1 }
    .view__garment{ opacity: 0 }
    .view__beam{ display: none }
    .detail-wrap{ display: none }
    .gl{ stroke-dashoffset: 0; opacity: 1 }
    .added__slot{ opacity: 1 }
    .added__slot svg{ transform: none }
    .added__slot .ml{ stroke: var(--cream) }
    .added__slot .ml--gold{ stroke: var(--gold) }
    .chip, .bubble, .talk__fit, .real__src, .real__never, .real__lede{
      opacity: 1; transform: none;
    }
    .real__src.in, .chip.in{ transform: none }
    .bubble__txt{ clip-path: none }
    .real__lines path{ opacity: 1 }
    .strike::after{ transform: scaleX(1) }
    .strike{ color: rgba(245,240,232,.3) }
  }
</style>

<script>
  // Four scenes on the shared scroll engine (src/lib/scroll.ts): it owns the
  // single scroll listener and rAF loop, hands each render a damped progress
  // value, and gates the scenes on visibility. Everything below is pure
  // choreography — read nothing, write only.
  import { scene, ramp, clamp01 } from "../lib/scroll";

  const $ = <T extends Element>(s: string) => document.querySelector<T>(s);
  const $$ = <T extends Element>(s: string) => [...document.querySelectorAll<T>(s)];

  // A class toggle is a style invalidation even when the value doesn't
  // change, and these run on every element every frame. Only touch the DOM
  // when the answer actually moved.
  const setClass = (el: Element, name: string, on: boolean, memo: Set<string>) => {
    const key = name;
    const had = memo.has(key);
    if (had === on) return;
    if (on) memo.add(key); else memo.delete(key);
    el.classList.toggle(name, on);
  };
  const memo = new WeakMap<Element, Set<string>>();
  const flags = (el: Element) => {
    let s = memo.get(el);
    // Seed from what's actually on the element, so a class rendered by the
    // server is never shadowed by an empty cache.
    if (!s) { s = new Set(el.classList); memo.set(el, s); }
    return s;
  };
  const flag = (el: Element | null, name: string, on: boolean) => {
    if (el) setClass(el, name, on, flags(el));
  };

  // ---- 01 · THE SCAN ------------------------------------------------------
  // The phone assembles from its lines, then reads five pieces one by one:
  // each draws in under the sweeping beam, its details are read off, and it
  // drops into the closet while the counter climbs 000 → 148.
  const scan = $<HTMLElement>('[data-scene="scan"]');
  const phone = $<HTMLElement>('[data-scan-phone]');
  const view = $<HTMLElement>('[data-scan-view]');
  const beam = $<HTMLElement>('[data-scan-beam]');
  const vgs = $$<HTMLElement>('[data-vg]');
  const details = $$<HTMLElement>('[data-detail]');
  const addedSlots = $$<HTMLElement>('[data-added]');
  const scanCounts = $$<HTMLElement>('[data-scan-count]');
  const PIECES = 148;

  // Measured out of band by the engine — reading it per frame (as this used
  // to) forces a layout on every single scroll frame.
  let viewH = 0;
  let lastCount = '';

  scene(scan, ({ p }) => {
    const N = vgs.length;
    if (!phone || !N) return;

    // the phone draws itself in from its lines
    phone.style.setProperty('--pd', ramp(p, 0, 0.12).toFixed(3));

    // the five-piece scan occupies the middle of the runway
    const A = 0.16, B = 0.90;
    const seg = (B - A) / N;
    const active = Math.min(N - 1, Math.max(0, Math.floor((p - A) / seg)));
    const local = clamp01((p - (A + active * seg)) / seg);   // phase in current piece

    // the gold beam sweeps top→bottom as the garment draws; then it locks
    const drawR = ramp(local, 0.06, 0.60);
    const scanning = p >= A && p < B && local > 0.02 && local < 0.64;
    if (beam) {
      beam.style.opacity = scanning ? '1' : '0';
      beam.style.transform = `translate3d(0, ${(drawR * (viewH - 2)).toFixed(1)}px, 0)`;
    }
    flag(view, 'is-lock', p >= A && p < B && local >= 0.58 && local < 0.76);

    // the piece in the frame: slide in, draw under the beam, then drop away
    // as it's filed into the closet
    for (let i = 0; i < N; i++) {
      const g = vgs[i];
      if (i !== active || p < A) { g.style.opacity = '0'; continue; }
      const enterR = ramp(local, 0, 0.16);
      const fileR = ramp(local, 0.72, 0.98);
      g.style.setProperty('--draw', drawR.toFixed(3));
      const inX = (1 - enterR) * 20;             // slide in from the right
      const outY = fileR * 26;                   // drop as it files
      const sc = 1 - fileR * 0.45;               // shrink as it files
      g.style.opacity = Math.min(enterR, 1 - fileR).toFixed(3);
      g.style.transform = `translate(-50%, -50%) translate3d(${inX.toFixed(1)}px, ${outY.toFixed(1)}px, 0) scale(${sc.toFixed(3)})`;
    }

    // the details, read off the active piece; "added" once it locks
    for (let i = 0; i < details.length; i++) {
      const onEnd = i === N - 1 && p >= B;
      flag(details[i], 'show', (i === active && p >= A && p < B) || onEnd);
      flag(details[i], 'added', i < active || (i === active && local >= 0.64) || onEnd);
    }

    // each read piece drops into its closet slot and stays
    for (let i = 0; i < addedSlots.length; i++) {
      flag(addedSlots[i], 'is-in', i < active || (i === active && local >= 0.66) || p >= B);
    }

    // counter climbs to 148 as the last piece is filed
    const n = String(Math.round(ramp(p, A, B) * PIECES)).padStart(3, '0');
    if (n !== lastCount) {
      lastCount = n;
      for (const el of scanCounts) el.textContent = n;
    }
  }, {
    damp: 80,
    measure: () => { viewH = view ? view.clientHeight : 0; },
  });

  // ---- 02 · THEN, NOTHING -------------------------------------------------
  const askChips = $$<HTMLElement>('[data-ask-chip]');
  scene($<HTMLElement>('[data-scene="ask"]'), ({ p }) => {
    for (let i = 0; i < askChips.length; i++) {
      flag(askChips[i], 'in', p > 0.22 + i * 0.18);
    }
  }, { damp: 95 });

  // ---- 03 · OR JUST TALK --------------------------------------------------
  const bubbles = $$<HTMLElement>('[data-bubble]').map(el => ({
    el, txt: el.querySelector<HTMLElement>('.bubble__txt'),
  }));
  const talkFit = $<HTMLElement>('[data-talk-fit]');

  // [bubble-in start, text-wipe start, text-wipe end]
  const BUBLINES: [number, number, number][] = [
    [0.14, 0.18, 0.38],
    [0.44, 0.48, 0.68],
  ];

  scene($<HTMLElement>('[data-scene="talk"]'), ({ p }) => {
    for (let i = 0; i < bubbles.length; i++) {
      const [a, t0, t1] = BUBLINES[i] ?? [0, 0, 1];
      flag(bubbles[i].el, 'in', p > a);
      bubbles[i].txt?.style.setProperty('--t', ramp(p, t0, t1).toFixed(3));
    }
    if (talkFit) {
      flag(talkFit, 'in', p > 0.66);
      talkFit.style.setProperty('--draw', ramp(p, 0.68, 0.88).toFixed(3));
    }
  }, { damp: 95 });

  // ---- 04 · THE REAL STYLIST ----------------------------------------------
  const realSrcs = $$<HTMLElement>('[data-real-src]');
  const realLines = $$<SVGPathElement>('[data-real-line]');
  const realFit = $<HTMLElement>('[data-real-fit]');
  const strikes = $$<HTMLElement>('[data-strike]');
  const realNever = $<HTMLElement>('[data-real-never]');
  const realLede = $<HTMLElement>('[data-real-lede]');

  scene($<HTMLElement>('[data-scene="real"]'), ({ p }) => {
    for (let i = 0; i < realSrcs.length; i++) {
      flag(realSrcs[i], 'in', p > 0.1 + i * 0.06);
    }
    for (let i = 0; i < realLines.length; i++) {
      realLines[i].style.setProperty('--draw', ramp(p, 0.16 + i * 0.07, 0.36 + i * 0.07).toFixed(3));
    }
    realFit?.style.setProperty('--draw', ramp(p, 0.42, 0.66).toFixed(3));
    for (let i = 0; i < strikes.length; i++) {
      const sx = ramp(p, 0.66 + i * 0.09, 0.74 + i * 0.09);
      strikes[i].style.setProperty('--sx', sx.toFixed(3));
      flag(strikes[i], 'is-dead', sx >= 1);
    }
    flag(realNever, 'in', p > 0.84);
    flag(realLede, 'in', p > 0.88);
  }, { damp: 90 });
</script>
