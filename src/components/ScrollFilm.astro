---
// src/components/ScrollFilm.astro
// The launch film, scrubbed by scroll — hardware-decoded <video>, not a frame
// sequence. A pinned "cinema on ink" stage: as you scroll the tall runway,
// the film's playhead is eased toward a scroll-mapped time, so the video
// plays forward/back with the scroll but stays smooth even when the scroll is
// chunky. The film is contain-fit (its typography and App Store badge are
// never cropped), opens from black and closes on its own "Get dressed / App
// Store" card that dissolves into the (already ink) footer.
//
// The scrub source is encoded with dense keyframes for fast seeking and has
// no audio. Under reduced-motion / no-JS the runway collapses and a real,
// playable <video controls> (with sound) is shown instead.
import { APP_STORE_URL } from "../lib/links";

const POSTER     = `/assets/launch-poster.jpg`;
const SCRUB_WEBM = `/assets/launch-scrub.webm`; // VP9, seek-optimised, silent
const SCRUB_MP4  = `/assets/launch-scrub.mp4`;  // H.264 fallback (Safari < 16)
const FILM       = `/assets/launch-film.mp4`;   // playable fallback, with audio
---
<section class="reel" data-reel aria-labelledby="reel-title">
  <div class="reel__stage">
    <!-- The scrubbed film. Poster shows until the first frame is decoded. -->
    <video
      class="reel__video" data-reel-video
      muted playsinline preload="none" poster={POSTER}
      tabindex="-1" aria-hidden="true" disablepictureinpicture
    >
      <source src={SCRUB_WEBM} type="video/webm" />
      <source src={SCRUB_MP4} type="video/mp4" />
    </video>

    <!-- Projection ambience -->
    <div class="reel__vignette" aria-hidden="true"></div>

    <!-- Real, tappable link over the painted "Get dressed / App Store" card,
         switched on as the film reaches its close. -->
    <a class="reel__endcta" data-reel-endcta href={APP_STORE_URL}
       aria-label="Get BURS on the App Store" tabindex="-1"></a>

    <!-- Accessible summary of the film (it carries the page's story) -->
    <h2 id="reel-title" class="reel__sr">
      The BURS film. An AI wardrobe stylist reads the clothes you already own,
      the weather, and your day — and answers in one outfit. Scroll to play the
      film, then get dressed at the App Store.
    </h2>

    <!-- Opening cue — the stage rests near-black, so hint that scroll plays it -->
    <div class="reel__cue" data-reel-cue aria-hidden="true">
      <span>SCROLL TO PLAY THE FILM</span>
      <span class="reel__cue-line"></span>
    </div>

    <!-- Fallback: a real, playable film (reduced-motion / no-JS) -->
    <div class="reel__fallback">
      <video
        class="reel__fallback-video"
        controls playsinline preload="none" poster={POSTER}
        aria-label="The BURS launch film"
      >
        <source src={FILM} type="video/mp4" />
      </video>
      <a class="cta cta--cream reel__fallback-cta" href={APP_STORE_URL}>
        Get the app <span class="cta__arrow">→</span>
      </a>
    </div>
  </div>

  <noscript>
    <style>
      /* Without JS the scrub can't run — collapse the runway and hand the
         viewer the real, playable film instead of a wall of empty scroll. */
      .reel { height: auto !important; }
      .reel .reel__stage { position: static !important; height: auto !important; min-height: 0 !important; overflow: visible !important; }
      .reel .reel__video, .reel .reel__cue, .reel .reel__vignette, .reel .reel__endcta { display: none !important; }
      .reel .reel__fallback { display: flex !important; }
    </style>
  </noscript>
</section>

<style>
  .reel{
    position: relative;
    /* Scroll runway — the whole 45s film plays out over this. Taller = slower,
       more slow-motion. This length gives a deliberate, cinematic crawl from
       the hero down to the footer. */
    height: 900vh;
    background: var(--ink);
  }
  @media (max-width: 800px){ .reel{ height: 640vh } }

  .reel__stage{
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;          /* track the visible viewport on iOS (address bar) */
    overflow: hidden;
    background: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reel__video{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;      /* never crop the film's type / badge */
    background: var(--ink);
    z-index: 0;
  }

  /* Projection: soft edge fall-off deepens the "darkened room" and blends the
     letterbox into the ink stage. Pointer-transparent. */
  .reel__vignette{
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    box-shadow:
      inset 0 0 160px rgba(0,0,0,.55),
      inset 0 0 60px rgba(0,0,0,.35);
    background:
      radial-gradient(120% 80% at 50% 50%, transparent 62%, rgba(0,0,0,.34) 100%);
  }

  /* Real, tappable link over the painted end-card CTA. Invisible (the frame is
     the visual); JS positions it over the button + badge and switches
     pointer-events on only once the film reaches its close. */
  .reel__endcta{
    position: absolute; z-index: 2;
    display: block; opacity: 0; pointer-events: none;
    border-radius: 999px;
    font-size: 0; color: transparent; text-decoration: none;
  }
  .reel__endcta.is-live{ pointer-events: auto; cursor: pointer }
  .reel__endcta:focus-visible{
    opacity: 1;
    outline: 2px solid var(--gold-bright);
    outline-offset: 6px;
  }

  /* Opening cue — fades out as soon as the film starts moving */
  .reel__cue{
    position: absolute; z-index: 2;
    bottom: clamp(34px, 7vh, 72px); left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    font-family: var(--mono); font-size: 9px; letter-spacing: .3em;
    text-transform: uppercase; color: rgba(245,240,232,.68);
    pointer-events: none;
    will-change: opacity, transform;
  }
  .reel__cue-line{
    width: 1px; height: 42px;
    background: linear-gradient(180deg, rgba(245,240,232,.55), transparent);
  }

  /* Visually-hidden but read by AT / indexed for SEO */
  .reel__sr{
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    clip: rect(0 0 0 0); clip-path: inset(50%); overflow: hidden;
    white-space: nowrap;
  }

  /* Fallback film — only shown under reduced-motion / no-JS */
  .reel__fallback{
    display: none;
    position: relative; z-index: 3;
    flex-direction: column; align-items: center; gap: 24px;
    width: min(1100px, 92vw);
  }
  .reel__fallback-video{
    width: 100%; height: auto; max-height: 82vh;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid rgba(245,240,232,.12);
    box-shadow: 0 40px 90px -40px rgba(0,0,0,.8);
  }

  @media (prefers-reduced-motion: reduce){
    .reel{ height: auto }
    .reel__stage{
      position: static; height: auto; min-height: 100vh;
      overflow: visible;
      padding-block: clamp(64px, 12vh, 140px);
    }
    .reel__video, .reel__cue, .reel__vignette, .reel__endcta{ display: none }
    .reel__fallback{ display: flex }
  }
</style>

<script>
  const reel   = document.querySelector<HTMLElement>('[data-reel]');
  const video  = document.querySelector<HTMLVideoElement>('[data-reel-video]');
  const cue    = document.querySelector<HTMLElement>('[data-reel-cue]');
  const endcta = document.querySelector<HTMLAnchorElement>('[data-reel-endcta]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reel && video && !reduced) {
    // The painted "Get dressed / App Store" card sits here within the frame:
    // button centred ~50%/80%, badge just below. This box covers both.
    const CTA = { x0: 0.33, y0: 0.745, w: 0.34, h: 0.215 };
    const AR = 16 / 9;
    const START_T = 0.45;          // skip the pure-black lead-in
    const EASE = 0.12;             // gentler catch-up = smoother, floatier glide
    const SEEK_EPS = 0.02;         // skip sub-frame seeks that wouldn't change the frame

    let duration = 0;
    let ready = false;
    let targetT = START_T;
    let curT = START_T;
    let lastSeek = -1;
    let rafId = 0;

    // Load the seek-optimised source (kept out of the network until now via
    // preload="none", so the page isn't heavier for a visitor who bounces).
    video.preload = 'auto';
    video.load();

    video.addEventListener('loadedmetadata', () => {
      duration = video.duration || 45;
    });

    // Prime the decoder with a muted play→pause so seeked frames actually
    // render (some engines won't paint a seek on a never-played video), then
    // hand control to the scrubber.
    video.addEventListener('loadeddata', () => {
      ready = true;
      const start = () => { try { video.currentTime = START_T; } catch {} update(); };
      const p = video.play();
      if (p && typeof p.then === 'function') {
        p.then(() => { video.pause(); start(); }).catch(start);
      } else { start(); }
    }, { once: true });

    // ---- Scroll → time --------------------------------------------------
    function progress() {
      const rect = reel!.getBoundingClientRect();
      const total = reel!.offsetHeight - window.innerHeight;
      const scrolled = Math.min(Math.max(-rect.top, 0), total);
      return total > 0 ? scrolled / total : 0;
    }
    const timeFor = (p: number) => {
      const d = duration || 45;
      return START_T + p * (d - START_T);
    };

    // Ease the playhead toward the scroll target. Setting currentTime once per
    // animation frame (not once per scroll event) keeps seeking decoupled from
    // scroll cadence, so it stays smooth however the wheel/trackpad fires.
    const seek = (t: number) => {
      if (Math.abs(t - lastSeek) < SEEK_EPS) return;   // sub-frame → no visible change
      try { video!.currentTime = t; lastSeek = t; } catch {}
    };
    function tick() {
      const d = targetT - curT;
      if (Math.abs(d) < 0.01) {
        curT = targetT;
        seek(curT);
        rafId = 0;
        return;
      }
      curT += d * EASE;
      seek(curT);
      rafId = requestAnimationFrame(tick);
    }

    function positionCta() {
      const W = video!.clientWidth, H = video!.clientHeight;
      let dw: number, dh: number;
      if (W / H > AR) { dh = H; dw = H * AR; } else { dw = W; dh = W / AR; }
      const dx = (W - dw) / 2, dy = (H - dh) / 2;
      endcta!.style.left = `${dx + dw * CTA.x0}px`;
      endcta!.style.top = `${dy + dh * CTA.y0}px`;
      endcta!.style.width = `${dw * CTA.w}px`;
      endcta!.style.height = `${dh * CTA.h}px`;
    }

    function update() {
      const p = progress();
      targetT = timeFor(p);
      if (ready && !rafId) rafId = requestAnimationFrame(tick);

      if (cue) {
        const c = Math.max(0, 1 - p / 0.04);   // gone after ~4% of the runway
        cue.style.opacity = String(c);
        cue.style.transform = `translateX(-50%) translateY(${(1 - c) * 10}px)`;
      }
      if (endcta) {
        const live = p >= 0.9;
        if (live) positionCta();
        endcta.classList.toggle('is-live', live);
        endcta.tabIndex = live ? 0 : -1;
      }
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; update(); });
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => { update(); }, { passive: true });
  }
</script>
