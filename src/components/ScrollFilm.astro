---
// src/components/ScrollFilm.astro
// The launch film, scrubbed by scroll. A pinned cinema stage on ink: as you
// scroll its tall runway, a 540-frame WebP sequence of the film scrubs on a
// <canvas>, frame-accurate at any scroll speed (the same technique the hero
// uses for the mark). The frames are contain-fit and centered so the film's
// own typography and App Store badge are never cropped, on any viewport; the
// ink stage reads as a darkened room with the film projected in it. The film
// opens from black and closes on its own dark "Get dressed" CTA card, which
// dissolves straight into the (already ink) footer.
//
// Falls back to a real <video controls> — playable, with sound — under
// reduced-motion and no-JS.
import { APP_STORE_URL } from "../lib/links";

const POSTER = `/assets/launch-poster.jpg`;
const FILM_MP4 = `/assets/launch-film.mp4`;
---
<section class="reel" data-reel aria-labelledby="reel-title">
  <div class="reel__stage">
    <!-- No-JS / pre-paint still: a frame from the film -->
    <img class="reel__poster" src={POSTER} alt="" aria-hidden="true" decoding="async" />

    <!-- The scrubbed film -->
    <canvas class="reel__canvas" data-reel-canvas aria-hidden="true"></canvas>

    <!-- Projection ambience -->
    <div class="reel__vignette" aria-hidden="true"></div>

    <!-- The film's closing frames paint a "Get dressed / App Store" card onto
         the (aria-hidden) canvas. This real link is positioned over that
         painted CTA and switched on as the film reaches its end, so the
         closing card is actually tappable — not just pixels. -->
    <a class="reel__endcta" data-reel-endcta href={APP_STORE_URL}
       aria-label="Get BURS on the App Store" tabindex="-1"></a>

    <!-- Accessible summary of the film (it carries the page's story) -->
    <h2 id="reel-title" class="reel__sr">
      The BURS film. An AI wardrobe stylist reads the clothes you already own,
      the weather, and your day — and answers in one outfit. Scroll to play the
      film, then get dressed at the App Store.
    </h2>

    <!-- Opening cue — the stage rests near-black, so hint that scroll plays it -->
    <div class="reel__cue" data-reel-cue aria-hidden="true">
      <span>SCROLL TO PLAY THE FILM</span>
      <span class="reel__cue-line"></span>
    </div>

    <!-- Fallback: a real, playable film (reduced-motion / no-JS) -->
    <div class="reel__fallback">
      <video
        class="reel__video"
        controls
        playsinline
        preload="none"
        poster={POSTER}
        aria-label="The BURS launch film"
      >
        <source src={FILM_MP4} type="video/mp4" />
      </video>
      <a class="cta cta--cream reel__fallback-cta" href={APP_STORE_URL}>
        Get the app <span class="cta__arrow">→</span>
      </a>
    </div>
  </div>

  <noscript>
    <style>
      /* Without JS the scrub can't run — collapse the runway and hand the
         viewer the real, playable film instead of a wall of empty scroll. */
      .reel { height: auto !important; }
      .reel .reel__stage { position: static !important; height: auto !important; min-height: 0 !important; overflow: visible !important; }
      .reel .reel__canvas, .reel .reel__poster, .reel .reel__cue, .reel .reel__vignette { display: none !important; }
      .reel .reel__fallback { display: flex !important; }
    </style>
  </noscript>
</section>

<style>
  .reel{
    position: relative;
    /* Scroll runway — the whole 45s film plays out over this. Taller = slower,
       more cinematic. Runs from the hero down to the footer. ~9px of scroll
       per frame here: frame-accurate and smooth at any speed. */
    height: 560vh;
    background: var(--ink);
  }
  @media (max-width: 800px){ .reel{ height: 440vh } }

  .reel__stage{
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reel__poster,
  .reel__canvas{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .reel__poster{ object-fit: contain; z-index: 0; background: var(--ink) }
  /* Once the canvas owns a frame, retire the poster so it never double-exposes */
  .reel[data-ready] .reel__poster{ opacity: 0 }
  .reel__canvas{ display: block; z-index: 1 }

  /* Projection: soft edge fall-off deepens the "darkened room" and blends the
     letterbox into the ink stage. Pointer-transparent. */
  .reel__vignette{
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    box-shadow:
      inset 0 0 160px rgba(0,0,0,.55),
      inset 0 0 60px rgba(0,0,0,.35);
    background:
      radial-gradient(120% 80% at 50% 50%, transparent 62%, rgba(0,0,0,.34) 100%);
  }

  /* Opening cue — fades out as soon as the film starts moving */
  .reel__cue{
    position: absolute; z-index: 3;
    bottom: clamp(34px, 7vh, 72px); left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    font-family: var(--mono); font-size: 9px; letter-spacing: .3em;
    text-transform: uppercase; color: rgba(245,240,232,.68);
    pointer-events: none;               /* never intercept the end-card click */
    will-change: opacity, transform;
  }

  /* Real, tappable link over the painted end-card CTA. Invisible (the frame
     is the visual); JS positions it over the button + badge and switches
     pointer-events on only once the film reaches its close. */
  .reel__endcta{
    position: absolute; z-index: 3;
    display: block; opacity: 0; pointer-events: none;
    border-radius: 999px;
    font-size: 0; color: transparent; text-decoration: none;
  }
  .reel__endcta.is-live{ pointer-events: auto; cursor: pointer }
  .reel__endcta:focus-visible{
    opacity: 1;
    outline: 2px solid var(--gold-bright);
    outline-offset: 6px;
  }
  .reel__cue-line{
    width: 1px; height: 42px;
    background: linear-gradient(180deg, rgba(245,240,232,.55), transparent);
  }

  /* Visually-hidden but read by AT / indexed for SEO */
  .reel__sr{
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    clip: rect(0 0 0 0); clip-path: inset(50%); overflow: hidden;
    white-space: nowrap;
  }

  /* Fallback film — only shown under reduced-motion / no-JS */
  .reel__fallback{
    display: none;
    position: relative; z-index: 4;
    flex-direction: column; align-items: center; gap: 24px;
    width: min(1100px, 92vw);
  }
  .reel__video{
    width: 100%; height: auto; max-height: 82vh;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid rgba(245,240,232,.12);
    box-shadow: 0 40px 90px -40px rgba(0,0,0,.8);
  }

  @media (prefers-reduced-motion: reduce){
    .reel{ height: auto }
    .reel__stage{
      position: static; height: auto; min-height: 100vh;
      overflow: visible;
      padding-block: clamp(64px, 12vh, 140px);
    }
    .reel__canvas, .reel__poster, .reel__cue, .reel__vignette{ display: none }
    .reel__fallback{ display: flex }
  }
</style>

<script>
  const reel   = document.querySelector<HTMLElement>('[data-reel]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-reel-canvas]');
  const cue    = document.querySelector<HTMLElement>('[data-reel-cue]');
  const endcta = document.querySelector<HTMLAnchorElement>('[data-reel-endcta]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reel && canvas && !reduced) {
    const ctx = canvas.getContext('2d', { alpha: false });

    const FRAME_COUNT = 540;
    const FRAME_V = '1';
    const BASE = '/assets/launch-seq/frame_';
    const pad = (n: number) => String(n).padStart(4, '0');
    const url = (i: number) => `${BASE}${pad(i + 1)}.webp?v=${FRAME_V}`;

    // Trim the deepest black of the fade-in so the runway opens on motion,
    // not a dead frame; hold the closing CTA card at the very end.
    const START = 3;
    const END = FRAME_COUNT - 1;

    // Coarse-first loading: a sparse grid gives every scroll position *some*
    // frame within ~1s, then the gaps fill in, prioritised around wherever
    // the viewer currently is.
    const STRIDE = 12;
    const MAX_INFLIGHT = 8;

    const frames: (HTMLImageElement | undefined)[] = new Array(FRAME_COUNT);
    const requested: boolean[] = new Array(FRAME_COUNT).fill(false);
    let inflight = 0;
    let ready = false;
    let targetIdx = START;

    const ramp = (p: number, a: number, b: number) =>
      Math.min(1, Math.max(0, (p - a) / (b - a)));
    // The painted "Get dressed / App Store" card sits here within the frame
    // (measured from the closing frame): button centred at ~50%/80%, badge
    // just below. This box covers both for a comfortable tap target.
    const CTA = { x0: 0.33, y0: 0.745, w: 0.34, h: 0.215 };
    // Client-space rect of the last drawn frame, so the link can track it.
    let lastRect = { dx: 0, dy: 0, dw: 0, dh: 0 };

    // ---- Canvas sizing (device-pixel-accurate) --------------------------
    let dpr = 1, cw = 0, chh = 0;
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      cw = canvas!.clientWidth;
      chh = canvas!.clientHeight;
      canvas!.width = Math.round(cw * dpr);
      canvas!.height = Math.round(chh * dpr);
    }

    const isLoaded = (img?: HTMLImageElement) =>
      !!img && img.complete && img.naturalWidth > 0;

    function nearestLoaded(i: number): HTMLImageElement | null {
      if (isLoaded(frames[i])) return frames[i]!;
      for (let d = 1; d < FRAME_COUNT; d++) {
        if (isLoaded(frames[i - d])) return frames[i - d]!;
        if (isLoaded(frames[i + d])) return frames[i + d]!;
      }
      return null;
    }

    // Contain-fit: the whole 16:9 frame, centered, letterboxed by the ink
    // stage — the film's type and badges are never cropped.
    function paint() {
      if (!ctx) return;
      const img = nearestLoaded(Math.min(END, Math.max(0, targetIdx)));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = '#0E0D0C';
      ctx.fillRect(0, 0, cw, chh);
      if (!img) return;
      const ir = img.naturalWidth / img.naturalHeight;
      const cr = cw / chh;
      let dw: number, dh: number;
      if (cr > ir) { dh = chh; dw = chh * ir; }   // pillarbox
      else { dw = cw; dh = cw / ir; }             // letterbox
      const dx = (cw - dw) / 2, dy = (chh - dh) / 2;
      lastRect = { dx, dy, dw, dh };
      ctx.drawImage(img, dx, dy, dw, dh);
      // Faint frame edge so the "screen" reads against the ink during dark beats
      ctx.strokeStyle = 'rgba(245,240,232,.05)';
      ctx.lineWidth = 1;
      ctx.strokeRect(dx + 0.5, dy + 0.5, dw - 1, dh - 1);
    }

    // ---- Progressive loader ---------------------------------------------
    function nextFrame(): number {
      let best = -1, bestScore = Infinity;
      for (let i = 0; i < FRAME_COUNT; i++) {
        if (requested[i]) continue;
        const sparse = i % STRIDE === 0 || i === START || i === END;
        const score = Math.abs(i - targetIdx) + (sparse ? 0 : 1e6);
        if (score < bestScore) { bestScore = score; best = i; }
      }
      return best;
    }

    function pump() {
      while (inflight < MAX_INFLIGHT) {
        const i = nextFrame();
        if (i < 0) break;
        requested[i] = true;
        const img = new Image();
        img.decoding = 'async';
        frames[i] = img;
        inflight++;
        const done = () => {
          inflight--;
          if (!ready && i === START && isLoaded(img)) {
            ready = true;
            reel!.setAttribute('data-ready', '');
          }
          // A freshly-arrived frame may be a better match for the current view
          paint();
          pump();
        };
        img.onload = done;
        img.onerror = done;
        img.src = url(i);
      }
    }

    // ---- Scroll → progress ----------------------------------------------
    function computeProgress() {
      const rect = reel!.getBoundingClientRect();
      const total = reel!.offsetHeight - window.innerHeight;
      const scrolled = Math.min(Math.max(-rect.top, 0), total);
      return total > 0 ? scrolled / total : 0;
    }

    function update() {
      const p = computeProgress();
      targetIdx = Math.round(START + p * (END - START));
      if (cue) {
        const c = Math.max(0, 1 - p / 0.04);   // gone after ~4% of the runway
        cue.style.opacity = String(c);
        cue.style.transform = `translateX(-50%) translateY(${(1 - c) * 10}px)`;
      }
      pump();
      paint();
      // Track the painted end-card CTA and switch the link on as it lands.
      if (endcta) {
        const live = ramp(p, 0.9, 0.965) > 0.02 && lastRect.dw > 0;
        if (live) {
          const { dx, dy, dw, dh } = lastRect;
          endcta.style.left = `${dx + dw * CTA.x0}px`;
          endcta.style.top = `${dy + dh * CTA.y0}px`;
          endcta.style.width = `${dw * CTA.w}px`;
          endcta.style.height = `${dh * CTA.h}px`;
        }
        endcta.classList.toggle('is-live', live);
        endcta.tabIndex = live ? 0 : -1;
      }
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; update(); });
    }

    resize();
    // Prime the loader (frames download before the section is even reached)
    requested[START] = true;
    (() => {
      const img = new Image();
      img.decoding = 'async';
      frames[START] = img;
      inflight++;
      const done = () => {
        inflight--;
        if (!ready && isLoaded(img)) { ready = true; reel!.setAttribute('data-ready', ''); }
        paint(); pump();
      };
      img.onload = done; img.onerror = done;
      img.src = url(START);
    })();
    pump();
    update();

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => { resize(); update(); }, { passive: true });
  }
</script>
