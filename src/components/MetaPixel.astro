---
// src/components/MetaPixel.astro
// Meta measurement foundation (Week 0 of the paid plan): domain-verification
// tag + a CONSENT-GATED Meta Pixel, rendered inside <head>.
//
// GDPR/ePrivacy: nothing loads, no cookie is set, and no request leaves the
// page until the visitor explicitly accepts via ConsentBanner.astro
// (localStorage "burs-consent-v1" === "granted", or a live "burs:consent"
// event in this session). Declining keeps the pixel off permanently until
// the visitor changes their mind via the footer's "Privacy choices".
// There is deliberately no <noscript> tracking fallback — it cannot be
// consent-gated.
//
// The domain-verification tag stays unconditional: it is a static ownership
// marker for Meta's crawler, processes no visitor data, and must be in the
// static HTML.
//
// Events once consented: PageView everywhere; ViewContent on pages passing
// the prop; InitiateAppStore (custom) via a delegated listener on any App
// Store link, carrying the campaign token resolved by CampaignToken.astro
// (window.__bursCampaign) — which must therefore render ahead of this
// component in <head>.
//
// PIXEL_ID = dataset "BURS Web Pixel" in the BURS AI Business Portfolio.
interface Props {
  /** Fire ViewContent too — used on /go, the paid-traffic landing. */
  viewContent?: boolean;
}
const { viewContent = false } = Astro.props;
const PIXEL_ID = "1349632843260427";
---
<meta name="facebook-domain-verification" content="mdel2htzygoexvhi6cp2ytouka4kw4" />
<script is:inline define:vars={{ PIXEL_ID, viewContent }}>
  (function () {
    var KEY = "burs-consent-v1";
    var loaded = false;

    function loadPixel() {
      if (loaded || window.fbq) return;
      loaded = true;

      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");

      fbq("init", PIXEL_ID);
      fbq("track", "PageView");
      if (viewContent) {
        fbq("track", "ViewContent", { content_name: window.location.pathname });
      }

      // Any click through to the App Store becomes a custom InitiateAppStore
      // event — the top-of-funnel signal the click-optimized campaigns read.
      //
      // The token comes from CampaignToken.astro (window.__bursCampaign), the
      // single resolver, NOT from a second read of the query string here. This
      // listener used to look at `src` alone and strip invalid characters out
      // of whatever it found, while /go resolved src → utm_campaign →
      // utm_source and rejected invalid values whole. A consented Meta visitor
      // who tapped the CTA before the 700ms handoff — or any Android visitor,
      // who gets no handoff at all — therefore reported src:"direct" and had
      // their paid conversion counted as organic. One resolver, one regex, one
      // fallback: the duplicate precedence logic is what caused the drift, so
      // do not reintroduce a local read of location.search.
      document.addEventListener("click", function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href*="apps.apple.com"]');
        if (!a || !window.fbq) return;
        fbq("trackCustom", "InitiateAppStore", {
          page: window.location.pathname,
          src: window.__bursCampaign || "direct",
        });
      });
    }

    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {
      /* storage blocked → treat as no consent */
    }
    if (stored === "granted") {
      loadPixel();
    } else {
      window.addEventListener("burs:consent", function (e) {
        if (e.detail === "granted") loadPixel();
      });
    }
  })();
</script>
