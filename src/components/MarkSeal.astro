---
// src/components/MarkSeal.astro
// The signature. The 100-frame sequence of the BURS mark stitching itself
// from loose thread — which used to open the page — now closes it: a pinned
// cream stage right before the footer where the mark draws in as you scroll,
// then the sign-off and the final ask fade up.
//
// Falls back to the finished mark (static poster) under reduced-motion and
// no-JS.
import { APP_STORE_URL } from "../lib/links";
import { TRIAL_DAYS } from "../lib/prices";

// FRAME_V busts browser/CDN caches when the frames are re-rendered.
const FRAME_V = "4";
const POSTER = `/assets/logo-seq/frame_100.webp?v=${FRAME_V}`;
---
<section class="seal" data-seal aria-label="BURS — the mark">
  <div class="seal__stage">
    <!-- No-JS / pre-paint fallback: the finished mark -->
    <img class="seal__poster" src={POSTER} alt="The BURS mark" decoding="async" />

    <!-- The scrubbed mark -->
    <canvas class="seal__canvas" data-seal-canvas aria-hidden="true"></canvas>

    <div class="seal__copy">
      <h2 class="seal__line" data-seal-in="0.72,0.86">This is <em>BURS</em>.</h2>
      <p class="seal__sub" data-seal-in="0.78,0.9">Your wardrobe, intelligently styled. {TRIAL_DAYS} days free.</p>
      <a class="cta cta--ink seal__cta" data-seal-in="0.84,0.95" href={APP_STORE_URL}>
        Start {TRIAL_DAYS} days free <span class="cta__arrow">→</span>
      </a>
    </div>
  </div>
</section>

<noscript>
  <style>
    .seal { height: auto !important; }
    .seal .seal__stage { position: static !important; height: auto !important; min-height: 100svh; }
    .seal .seal__canvas { display: none !important; }
    .seal [data-seal-in] { opacity: 1 !important; transform: none !important; visibility: visible !important; }
  </style>
</noscript>

<style>
  .seal{
    position: relative;
    /* Scroll runway for the mark to stitch itself in. */
    height: 260vh;
    background: var(--cream);
  }
  @media (max-width: 800px){ .seal{ height: 220vh } }

  .seal__stage{
    position: sticky; top: 0;
    height: 100vh; height: 100svh;
    overflow: hidden;
  }

  .seal__poster,
  .seal__canvas{ position: absolute; inset: 0; width: 100%; height: 100% }
  .seal__poster{ object-fit: contain; padding: 10vh 8vw }
  /* Once JS owns the canvas, retire the poster */
  .seal[data-ready] .seal__poster{ opacity: 0 }
  .seal__canvas{ display: block; opacity: 0; background: var(--cream) }
  .seal[data-ready] .seal__canvas{ opacity: 1 }

  .seal__copy{
    position: absolute; left: 0; right: 0;
    bottom: clamp(40px, 8vh, 90px);
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    text-align: center;
  }
  .seal__line{
    margin: 0; font-family: var(--display); font-weight: 200;
    letter-spacing: -.035em; line-height: 1;
    font-size: clamp(34px, 5vw, 72px); color: var(--charcoal);
    text-shadow: 0 0 16px var(--cream), 0 0 16px var(--cream), 0 0 36px var(--cream);
  }
  .seal__line em{ font-style: italic; color: var(--gold); font-weight: 300 }
  .seal__sub{
    font-family: var(--serif); font-style: italic;
    font-size: clamp(15px, 1.6vw, 19px); color: var(--charcoal-2);
    text-shadow: 0 0 14px var(--cream), 0 0 14px var(--cream);
  }
  .seal__cta{ margin-top: 10px; pointer-events: auto }

  /* Ink CTA for the cream surface */
  .cta--ink{ background: var(--ink); color: var(--cream); border-color: var(--ink) }
  .cta--ink:hover{ background: var(--gold-deep); border-color: var(--gold-deep); color: var(--ink) }

  /* visibility keeps the CTA out of the tab order (and off pointers) until
     it has actually faded in; JS flips it alongside the opacity. */
  [data-seal-in]{ opacity: 0; transform: translateY(14px); visibility: hidden; will-change: opacity, transform }

  @media (prefers-reduced-motion: reduce){
    .seal{ height: auto }
    .seal__stage{ position: static; height: auto; min-height: 100svh }
    .seal__canvas{ display: none }
    .seal[data-ready] .seal__poster{ opacity: 1 }
    [data-seal-in]{ opacity: 1; transform: none; visibility: visible }
  }
</style>

<script>
  import { scene, ramp } from "../lib/scroll";

  const seal = document.querySelector<HTMLElement>('[data-seal]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-seal-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (seal && canvas && !reduced) {
    const ctx = canvas.getContext('2d', { alpha: false });
    const FRAME_COUNT = 100;
    const BASE = '/assets/logo-seq/frame_';
    const FRAME_V = '4';
    const pad = (n: number) => String(n).padStart(3, '0');

    const frames: HTMLImageElement[] = [];
    let armed = false;

    // Repaint (coalesced) as frames arrive, so a mid-runway landing on a
    // still-loading frame fills in the moment it decodes. `refresh()` wakes
    // the engine, which re-renders this scene with its current progress.
    let paintQueued = false;
    function queueRender() {
      if (paintQueued) return;
      paintQueued = true;
      requestAnimationFrame(() => { paintQueued = false; render(lastP); });
    }

    // Load the sequence only once the seal approaches (it's the last section;
    // most of the page shouldn't pay for it up front).
    function arm() {
      if (armed) return;
      armed = true;
      for (let i = 1; i <= FRAME_COUNT; i++) {
        const img = new Image();
        img.decoding = 'async';
        img.onload = queueRender;
        img.src = `${BASE}${pad(i)}.webp?v=${FRAME_V}`;
        frames.push(img);
      }
    }
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some(e => e.isIntersecting)) { io.disconnect(); arm(); }
      }, { rootMargin: '150% 0px' });
      io.observe(seal);
    } else {
      arm();
    }

    // ---- Canvas sizing / painting (contain, mark slightly inset) ----------
    let dpr = 1, cw = 0, chh = 0;
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      cw = canvas!.clientWidth;
      chh = canvas!.clientHeight;
      canvas!.width = Math.round(cw * dpr);
      canvas!.height = Math.round(chh * dpr);
    }

    const isLoaded = (img?: HTMLImageElement) =>
      !!img && img.complete && img.naturalWidth > 0;

    // Paints the nearest earlier loaded frame; returns its index (-1 if none
    // has decoded yet) so render() can decide when the canvas is presentable.
    function paint(idx: number): number {
      if (!ctx) return -1;
      // Fall back to the nearest earlier loaded frame so the stitch always
      // shows progress, even while later frames are still downloading.
      let i = Math.min(FRAME_COUNT - 1, Math.max(0, idx));
      while (i > 0 && !isLoaded(frames[i])) i--;
      const img = frames[i];
      if (!isLoaded(img)) return -1;
      const ir = img.naturalWidth / img.naturalHeight;
      const cr = cw / chh;
      const SCALE = 0.84;             // clearance for the sign-off below
      let dw: number, dh: number;
      if (cr > ir) { dw = cw; dh = cw / ir; }
      else { dh = chh; dw = chh * ir; }
      dw *= SCALE; dh *= SCALE;
      const dx = (cw - dw) / 2;
      const dy = (chh - dh) / 2 - chh * 0.03;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = '#F5F0E8';
      ctx.fillRect(0, 0, cw, chh);
      ctx.drawImage(img, dx, dy, dw, dh);
      return i;
    }

    // ---- Sign-off overlays -------------------------------------------------
    const overlays = Array.from(seal.querySelectorAll<HTMLElement>('[data-seal-in]')).map(el => {
      const [a, b] = (el.dataset.sealIn ?? '0,1').split(',').map(Number);
      return { el, a, b };
    });

    let lastP = 0;
    let lastFrame = -1;

    function render(p: number) {
      lastP = p;
      // The mark stitches in over the first ~80% of the runway, then holds.
      const scrub = ramp(p, 0, 0.8);
      const target = Math.round(scrub * (FRAME_COUNT - 1));
      // Only touch the canvas when the sequence has actually advanced a
      // frame; damped progress moves continuously, but the sequence is only
      // 100 frames deep, so most frames would redraw the same image.
      if (target !== lastFrame) {
        lastFrame = target;
        const painted = paint(target);
        // Swap the finished-mark poster for the canvas only once the canvas
        // is actually caught up to the viewer's position — a slow connection
        // landing mid-runway keeps the poster instead of a near-empty frame 1.
        if (painted >= 0 && painted >= target - 4 && !seal!.hasAttribute('data-ready')) {
          seal!.setAttribute('data-ready', '');
        }
      }
      for (const o of overlays) {
        const v = ramp(p, o.a, o.b);
        o.el.style.opacity = String(v);
        o.el.style.transform = `translate3d(0, ${((1 - v) * 14).toFixed(1)}px, 0)`;
        o.el.style.visibility = v > 0.02 ? 'visible' : 'hidden';
      }
    }

    scene(seal, ({ p }) => render(p), {
      // The mark is a 100-frame sequence: damping here is what turns a wheel
      // notch from a jump of several frames into a continuous stitch.
      damp: 85,
      measure: () => { resize(); lastFrame = -1; },
    });
  }
</script>
