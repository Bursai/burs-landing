---
// src/components/WeekReel.astro
// "A week, styled" — a scroll-driven week. A pinned stage on ink: as you
// scroll, the days glide through the centre one at a time (Mon → Sun) and each
// day's outfit draws itself in on a hanger (line-art, echoing the hero's mark
// drawing itself). Past days read as "worn". It closes on the App Store CTA —
// the film's closing beat, restated as the week you'll actually live.
//
// Dark on purpose: it flows out of the (ink) film and into the (ink) footer,
// and keeps the fixed cream nav legible the whole way down.
import { APP_STORE_URL } from "../lib/links";

// Line-art garments — a shared hanger + a per-day silhouette. Paths carry
// pathLength="1" so they can be "drawn" by scroll via stroke-dashoffset.
const HANGER = [
  "M60 22c0-7-3-12 3-14 5-1.6 9 2 7.5 6.5",     // hook
  "M60 22 L33 47 Q60 56 87 47 Z",                // triangle bar
];

interface Garment { line: string[]; gold: string[] }
const GARMENTS: Record<string, Garment> = {
  blazer: {
    line: ["M39 47C33 66 32 108 35 150 L57 150 L59 84 L61 84 L63 150 L85 150 C88 108 87 66 81 47"],
    gold: ["M59 52 L51 92", "M61 52 L69 92", "M52 49 L59 63", "M68 49 L61 63"],
  },
  knit: {
    line: ["M39 47C31 60 27 74 30 96 L38 92 C34 118 35 140 38 150 L82 150 C86 140 87 118 82 92 L90 96 C93 74 89 60 81 47"],
    gold: ["M50 48 Q60 58 70 48", "M42 146 L42 150", "M54 146 L54 150", "M66 146 L66 150", "M78 146 L78 150"],
  },
  dress: {
    line: ["M41 47C37 60 39 74 42 86 L30 152 L90 152 L78 86 C81 74 83 60 79 47"],
    gold: ["M42 86 L78 86", "M52 48 Q60 56 68 48"],
  },
  shirt: {
    line: ["M40 47C36 62 35 108 37 150 L83 150 C85 108 84 62 80 47", "M40 47C31 62 29 82 34 96", "M80 47C89 62 91 82 86 96"],
    gold: ["M53 47 L60 57 L67 47", "M60 57 L60 150"],
  },
  coat: {
    line: ["M38 47C32 66 31 116 34 158 L57 158 L59 88 L61 88 L63 158 L86 158 C89 116 88 66 82 47"],
    gold: ["M59 52 L49 98", "M61 52 L71 98", "M35 102 L85 102"],
  },
  tee: {
    line: ["M36 47C33 55 31 63 33 70 L40 66 C38 100 39 130 41 150 L79 150 C81 130 82 100 80 66 L87 70 C89 63 87 55 84 47"],
    gold: ["M50 48 Q60 57 70 48"],
  },
  cardigan: {
    line: ["M39 47C33 64 32 110 35 152 L58 152 L58 66", "M62 66 L62 152 L85 152 C88 110 87 64 81 47"],
    gold: ["M52 49 L58 66", "M68 49 L62 66"],
  },
};

interface Day { dow: string; date: string; occasion: string; outfit: string; garment: string }
const days: Day[] = [
  { dow: "MON", date: "12", occasion: "The pitch",     outfit: "Tailored blazer, ivory shirt, a clean trouser.", garment: "blazer" },
  { dow: "TUE", date: "13", occasion: "Studio day",    outfit: "Relaxed knit, straight-leg denim.",             garment: "knit" },
  { dow: "WED", date: "14", occasion: "Dinner, 7pm",   outfit: "The slip dress, a soft coat over.",             garment: "dress" },
  { dow: "THU", date: "15", occasion: "Back-to-back",  outfit: "Crisp shirt, sharp tailoring.",                 garment: "shirt" },
  { dow: "FRI", date: "16", occasion: "The off-site",  outfit: "Overcoat, roll-neck, room to move.",            garment: "coat" },
  { dow: "SAT", date: "17", occasion: "Off the clock", outfit: "The favourite tee, layered easy.",              garment: "tee" },
  { dow: "SUN", date: "18", occasion: "Slow morning",  outfit: "Long cardigan, nothing to prove.",              garment: "cardigan" },
];
---
<section class="week" data-week aria-labelledby="week-title">
  <div class="week__stage">
    <div class="week__head wrap">
      <p class="eyebrow">A WEEK, STYLED</p>
      <h2 id="week-title" class="week__title">An outfit for <em>every</em> day.</h2>
      <p class="week__counter">
        <span data-week-dow>MON</span> · <span data-week-idx>1</span>/7
      </p>
    </div>

    <div class="week__track" data-week-track>
      {days.map((d, i) => (
        <figure class="day" data-day={i} class:list={[i === 0 && "is-active"]}>
          <div class="day__card">
            <p class="day__dow">{d.dow}<span class="day__date">{d.date}</span></p>
            <div class="day__art" aria-hidden="true">
              <svg viewBox="0 0 120 175" class="day__svg" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <g class="hanger">
                  {HANGER.map(p => <path d={p} />)}
                </g>
                <g class="garment">
                  {GARMENTS[d.garment].line.map(p => <path class="gl" d={p} pathLength="1" />)}
                  {GARMENTS[d.garment].gold.map(p => <path class="gl gl--gold" d={p} pathLength="1" />)}
                </g>
              </svg>
            </div>
            <p class="day__occasion">{d.occasion}</p>
            <p class="day__outfit">{d.outfit}</p>
            <span class="day__worn" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none"><path d="M3 8.5 L6.5 12 L13 4" /></svg>
              Worn
            </span>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="week-close section--ink">
  <div class="wrap week-close__inner">
    <p class="eyebrow">— EVERY MORNING, ALREADY DECIDED</p>
    <h2 class="week-close__h">Seven days. <em>Seven outfits.</em> None of them a decision.</h2>
    <a class="cta cta--cream" href={APP_STORE_URL}>Get the app <span class="cta__arrow">→</span></a>
  </div>
</section>

<style>
  .week{ position: relative; height: 480vh; background: var(--ink) }
  @media (max-width: 800px){ .week{ height: 420vh } }

  .week__stage{
    position: sticky; top: 0;
    height: 100vh; height: 100svh;
    overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
    color: var(--cream);
  }

  .week__head{
    position: absolute; top: clamp(20px, 5vh, 52px); left: 0; right: 0;
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
  }
  .week__head .eyebrow{ color: var(--gold-bright); opacity: 1 }
  .week__title{
    margin: 0; font-family: var(--display); font-weight: 200; letter-spacing: -.03em; line-height: 1;
    font-size: clamp(28px, 4vw, 56px); color: var(--cream);
  }
  .week__title em{ font-style: italic; color: var(--gold); font-weight: 300 }
  .week__counter{
    font-family: var(--mono); font-size: 11px; letter-spacing: .3em; color: rgba(245,240,232,.5);
    margin-top: 4px;
  }
  .week__counter span{ color: var(--gold-bright) }

  .week__track{
    display: flex; align-items: center;
    gap: clamp(20px, 3vw, 52px);
    padding-inline: 50vw;                /* room to centre the end days */
    width: max-content;
    will-change: transform;
  }

  .day{ margin: 0 }
  .day__card{
    width: clamp(230px, 26vw, 330px);
    background: rgba(245,240,232,.03);
    border: 1px solid rgba(245,240,232,.12);
    border-radius: 3px;
    padding: clamp(18px, 2vw, 28px);
    display: flex; flex-direction: column; align-items: center;
    transition: transform .55s var(--eo), opacity .55s var(--eo),
                border-color .55s var(--eo), background .55s var(--eo);
    transform: scale(.9); opacity: .4;
  }
  .day.is-active .day__card{
    transform: scale(1); opacity: 1;
    border-color: rgba(201,168,108,.5);
    background: rgba(245,240,232,.05);
    box-shadow: 0 40px 90px -50px rgba(0,0,0,.9), 0 0 0 1px rgba(201,168,108,.12);
  }

  .day__dow{
    align-self: stretch;
    display: flex; align-items: baseline; justify-content: space-between;
    font-family: var(--mono); font-size: 12px; letter-spacing: .28em; color: var(--cream);
  }
  .day__date{ color: rgba(245,240,232,.4); font-size: 11px }

  .day__art{ width: 100%; aspect-ratio: 3/4; display: grid; place-items: center; margin: 6px 0 4px }
  .day__svg{ width: 72%; height: 100%; overflow: visible }
  .hanger path{ stroke: rgba(245,240,232,.55); stroke-width: 1.4; fill: none }
  .garment .gl{
    stroke: var(--cream); stroke-width: 1.6; fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--draw, 0));
  }
  .garment .gl--gold{ stroke: var(--gold); stroke-width: 1.5 }

  .day__occasion{
    font-family: var(--display); font-style: italic; font-weight: 300;
    font-size: clamp(19px, 1.7vw, 24px); color: var(--cream); text-align: center; margin-top: 4px;
  }
  .day__outfit{
    font-family: var(--serif); font-style: italic; font-size: 14px; line-height: 1.45;
    color: rgba(245,240,232,.62); text-align: center; margin-top: 8px; max-width: 26ch;
    min-height: 3.2em;
  }
  .day__worn{
    display: inline-flex; align-items: center; gap: 6px; margin-top: 12px;
    font-family: var(--mono); font-size: 9px; letter-spacing: .22em; text-transform: uppercase;
    color: var(--gold-bright);
    opacity: 0; transform: translateY(4px);
    transition: opacity .4s var(--eo), transform .4s var(--eo);
  }
  .day__worn svg{ width: 14px; height: 14px; stroke: var(--gold-bright); stroke-width: 1.8; fill: none }
  .day.is-worn .day__worn{ opacity: 1; transform: none }

  /* Closing beat */
  .week-close{ padding-block: clamp(90px, 16vh, 200px) }
  .week-close__inner{ text-align: center; display: flex; flex-direction: column; align-items: center; gap: 22px }
  .week-close .eyebrow{ color: var(--gold-bright); opacity: 1 }
  .week-close__h{
    margin: 0; font-family: var(--display); font-weight: 200; letter-spacing: -.03em; line-height: 1.02;
    font-size: clamp(34px, 5.2vw, 76px); color: var(--cream); max-width: 20ch; text-wrap: balance;
  }
  .week-close__h em{ font-style: italic; color: var(--gold); font-weight: 300 }

  @media (max-width: 700px){
    .week__head{ top: clamp(16px, 8vh, 40px) }
    .day__outfit{ min-height: 4.2em }
  }

  @media (prefers-reduced-motion: reduce){
    .week{ height: auto }
    .week__stage{ position: static; height: auto; overflow: visible; padding-block: clamp(56px, 10vh, 120px) }
    .week__track{
      flex-wrap: wrap; justify-content: center; width: auto; padding-inline: var(--gutter);
      transform: none !important; margin-top: clamp(80px, 14vh, 140px);
    }
    .day__card{ transform: none; opacity: 1 }
    /* No scroll to drive the draw — show the outfits fully */
    .garment .gl{ stroke-dashoffset: 0 }
    .day__worn{ display: none }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-week]');
  const track = document.querySelector<HTMLElement>('[data-week-track]');
  const dowEl = document.querySelector<HTMLElement>('[data-week-dow]');
  const idxEl = document.querySelector<HTMLElement>('[data-week-idx]');
  const dayEls = [...document.querySelectorAll<HTMLElement>('[data-day]')];
  const DOW = ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && track && dayEls.length && !reduced) {
    const N = dayEls.length;
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    let active = -1;

    function render() {
      const total = section!.offsetHeight - window.innerHeight;
      const p = total > 0 ? clamp01(-section!.getBoundingClientRect().top / total) : 0;
      const q = p * (N - 1);   // continuous "centred day" index

      // Glide the track so day q sits on the centre line.
      const mid = window.innerWidth / 2;
      const first = dayEls[0], last = dayEls[N - 1];
      const c0 = first.offsetLeft + first.offsetWidth / 2;
      const c1 = last.offsetLeft + last.offsetWidth / 2;
      const x = c0 + (c1 - c0) * (q / (N - 1)) - mid;
      track!.style.transform = `translate3d(${-x}px,0,0)`;

      const nowActive = Math.round(q);
      dayEls.forEach((el, i) => {
        // draw the outfit in as the day approaches the centre; hold it after
        const draw = clamp01((q - (i - 0.7)) / 0.9);
        el.style.setProperty('--draw', draw.toFixed(3));
        el.classList.toggle('is-active', i === nowActive);
        el.classList.toggle('is-worn', q > i + 0.4);
      });

      if (nowActive !== active) {
        active = nowActive;
        if (dowEl) dowEl.textContent = DOW[active] ?? 'MON';
        if (idxEl) idxEl.textContent = String(active + 1);
      }
    }

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; render(); });
    };

    render();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
